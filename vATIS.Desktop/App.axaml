<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Vatsim.Vatis.App"
             Name="vATIS"
             RequestedThemeVariant="Dark">
    <NativeMenu.Menu>
        <NativeMenu/>
    </NativeMenu.Menu>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <StyleInclude Source="/Ui/Styles/DarkComboBox.axaml"/>
        <StyleInclude Source="/Ui/Styles/AvaloniaEditorStyles.axaml"/>
        <StyleInclude Source="/Ui/Styles/ScrollViewerStyles.axaml"/>
        <StyleInclude Source="/Ui/Styles/DataGridStyles.axaml"/>
        <StyleInclude Source="/Ui/Styles/KeyboardNavigationStyles.axaml"/>
        <!--
            Virtualized lists work out how many rows to create from their visible area, which comes out too small
            inside the scaled windows and leaves the lower rows missing. These lists are short, so show every row.
        -->
        <Style Selector="ListBox, ComboBox">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <!-- Popups (context menus, tooltips, lists) take on the UI scale of the control they open from. -->
        <Style Selector="Popup">
            <Setter Property="InheritsTransform" Value="True"/>
        </Style>
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Ui/Styles/Buttons.axaml"/>
                <ResourceInclude Source="/Ui/Styles/TextBox.axaml"/>
                <ResourceInclude Source="/Ui/Styles/CheckBox.axaml"/>
                <ResourceInclude Source="/Ui/Styles/RadioButton.axaml"/>
                <ResourceInclude Source="/Ui/Styles/ToggleSwitch.axaml"/>
                <ResourceInclude Source="/Ui/Controls/CustomTabControl.axaml"/>
                <ResourceInclude Source="/Ui/Controls/CustomTabItem.axaml"/>
                <ResourceInclude Source="/Ui/Controls/GroupBox/GroupBoxBasic.axaml"/>
                <ResourceInclude Source="/Ui/Controls/GroupBox/GroupBoxClassic.axaml"/>
                <ResourceInclude Source="/Ui/Styles/ScrollBarResources.axaml"/>
                <ResourceInclude Source="/Ui/Controls/Notification/Notification.axaml"/>
                <ResourceInclude Source="/Ui/Styles/MiniWindowMenu.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <FontFamily x:Key="UiFont">/Assets/Fonts#IBM Plex Sans</FontFamily>
        <FontFamily x:Key="Icons">/Assets/Fonts#mdl2</FontFamily>
        <FontFamily x:Key="Monospace">/Assets/Fonts#Intel One Mono</FontFamily>
        <StaticResource x:Key="ContentControlThemeFontFamily" ResourceKey="UiFont" />
        <x:Double x:Key="UiFontSize">14</x:Double>
        <StaticResource x:Key="ControlContentThemeFontSize" ResourceKey="UiFontSize" />
    </Application.Resources>
</Application>
