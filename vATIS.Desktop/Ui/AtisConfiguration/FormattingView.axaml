<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Vatsim.Vatis.Ui.ViewModels.AtisConfiguration"
             xmlns:behaviors="using:Vatsim.Vatis.Ui.Behaviors"
             xmlns:controls="using:Vatsim.Vatis.Ui.Controls"
             xmlns:converters="using:Vatsim.Vatis.Ui.Converters"
             xmlns:models="clr-namespace:Vatsim.Vatis.Profiles.Models"
             xmlns:groupBox="clr-namespace:Vatsim.Vatis.Ui.Controls.GroupBox"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Vatsim.Vatis.Ui.AtisConfiguration.FormattingView">
	<UserControl.Styles>
		<Style Selector="controls|TemplateVariableTextBox">
			<Setter Property="FontFamily" Value="{StaticResource Monospace}"/>
		</Style>
		<!-- The pages of a component are picked from the tab strip above the panel, so the tab strip of each page is hidden. -->
		<Style Selector="TabControl.Pages">
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="TabControl.Pages /template/ ItemsPresenter#PART_ItemsPresenter">
			<Setter Property="IsVisible" Value="False"/>
		</Style>
		<Style Selector="TabControl.Pages /template/ ContentPresenter#PART_SelectedContentHost">
			<Setter Property="Padding" Value="0"/>
		</Style>
		<!-- Folder style tabs that sit on the panel, like the station tabs in the main window. -->
		<Style Selector="ListBox.PageTabs ListBoxItem">
			<Setter Property="Margin" Value="-1,0,0,0"/>
			<Setter Property="Padding" Value="10,4"/>
			<Setter Property="Foreground" Value="#848484"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="ListBox.PageTabs ListBoxItem:nth-child(1)">
			<Setter Property="Margin" Value="0"/>
		</Style>
		<Style Selector="ListBox.PageTabs ListBoxItem /template/ ContentPresenter">
			<Setter Property="Background" Value="#323232"/>
			<Setter Property="BorderBrush" Value="#646464"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="0"/>
		</Style>
		<Style Selector="ListBox.PageTabs ListBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#3A3A3A"/>
			<Setter Property="TextElement.Foreground" Value="White"/>
		</Style>
		<Style Selector="ListBox.PageTabs ListBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="#1E1E1E"/>
			<Setter Property="BorderThickness" Value="1,1,1,0"/>
			<Setter Property="Padding" Value="10,4,10,5"/>
			<Setter Property="TextElement.Foreground" Value="White"/>
		</Style>
		<Style Selector="ListBox.PageTabs ListBoxItem:selected:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#1E1E1E"/>
		</Style>
		<!-- The panel's top left corner is square where the first tab joins it. -->
		<Style Selector="Border#PartFormattingBorder">
			<Setter Property="CornerRadius" Value="4"/>
		</Style>
		<Style Selector="Border#PartFormattingBorder.HasTabs">
			<Setter Property="CornerRadius" Value="0,4,4,4"/>
		</Style>
		<Style Selector="FlyoutPresenter.variables">
			<Setter Property="Background" Value="#3C3C3C"/>
			<Setter Property="BorderBrush" Value="#9A9A9A"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Padding" Value="16"/>
			<Setter Property="MaxWidth" Value="620"/>
		</Style>
	</UserControl.Styles>
	<UserControl.Resources>
		<converters:StringToBoolConverter x:Key="StringToBoolConverter"/>
	</UserControl.Resources>
	<Grid RowDefinitions="Auto,Auto,Auto,*">
		<ComboBox Grid.Row="0" Margin="0,0,0,10" Padding="10,10" FontSize="15" MaxHeight="100" Name="ComponentDropdown" HorizontalContentAlignment="Left" Classes="Dark Large" MaxDropDownHeight="520" ItemsSource="{Binding FormattingOptions, DataType=vm:FormattingViewModel}" SelectedItem="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel}">
			<ComboBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding}" />
				</DataTemplate>
			</ComboBox.ItemTemplate>
		</ComboBox>
		<WrapPanel Grid.Row="1" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6" Margin="0,0,0,10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Wind'}">
                    <CheckBox x:Name="SpeakWindSpeedGroupFormat" IsChecked="{Binding SpeakWindSpeedGroupFormat, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}">Speak wind speed in group format</CheckBox>
                    <CheckBox IsEnabled="{Binding !#SpeakWindSpeedGroupFormat.IsChecked}" IsChecked="{Binding SpeakWindSpeedLeadingZero, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}">Speak wind speed leading zero</CheckBox>
			<StackPanel Orientation="Horizontal" Spacing="10">
				<CheckBox IsChecked="{Binding MagneticVariationEnabled, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}" Name="MagneticVariation">Magnetic Variation</CheckBox>
				<TextBox FontFamily="{StaticResource Monospace}" Text="{Binding MagneticVariationValue, DataType=vm:FormattingViewModel}" MaxLength="3" MinWidth="60" IsEnabled="{Binding #MagneticVariation.IsChecked}" Theme="{StaticResource DarkTextBox}">
					<Interaction.Behaviors>
						<behaviors:TextBoxNumericNegativeBehavior/>
					</Interaction.Behaviors>
				</TextBox>
			</StackPanel>
		</WrapPanel>
		<ScrollViewer Grid.Row="2" Margin="0,0,0,-1" ZIndex="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" IsVisible="{Binding HasFormattingPages, DataType=vm:FormattingViewModel}">
			<ListBox Classes="PageTabs" Background="Transparent" BorderThickness="0" Padding="0" SelectionMode="Single" ItemsSource="{Binding FormattingPages, DataType=vm:FormattingViewModel}" SelectedItem="{Binding SelectedFormattingPageItem, DataType=vm:FormattingViewModel}">
				<ListBox.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Orientation="Horizontal"/>
					</ItemsPanelTemplate>
				</ListBox.ItemsPanel>
				<ListBox.ItemTemplate>
					<DataTemplate DataType="vm:FormattingPage">
						<TextBlock Text="{Binding Title}"/>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</ScrollViewer>
		<Border Grid.Row="3" Name="PartFormattingBorder" Classes.HasTabs="{Binding HasFormattingPages, DataType=vm:FormattingViewModel}" Background="#1E1E1E" BorderBrush="#646464" BorderThickness="1" Padding="10">
			<Grid>
			<!--Observation Time-->
			<Grid RowDefinitions="Auto,*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Observation Time'}">
				<StackPanel Grid.Row="0" Orientation="Vertical" Spacing="5">
					<TextBlock Text="Routine Observation Time:" VerticalAlignment="Center" ToolTip.Tip="The routine observation time (minutes) of this METAR station. For example, if the METAR is normally updated at 53 minutes past the hour, enter 53. If the METAR has multiple routine observation times, enter the intervals separated by a comma (e.g. 15, 45)"/>
					<TextBox FontFamily="{StaticResource Monospace}" Text="{Binding RoutineObservationTime, DataType=vm:FormattingViewModel}" MinWidth="150" Theme="{StaticResource DarkTextBox}">
						<Interaction.Behaviors>
							<behaviors:RoutineObservationTimeFormatBehavior/>
							<behaviors:SelectAllTextOnFocusBehavior/>
						</Interaction.Behaviors>
					</TextBox>
				</StackPanel>
				<groupBox:GroupBoxControl Grid.Row="1" Theme="{StaticResource GroupBoxSection}">
					<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
						<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
							<TextBlock Text="Text:" VerticalAlignment="Center"/>
							<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding ObservationTimeTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
						</Grid>
						<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
							<TextBlock Text="Voice:" VerticalAlignment="Center"/>
							<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding ObservationTimeVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
						</Grid>
						<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
                            <Button
                                Theme="{StaticResource DarkVariable}"
                                ToolTip.Tip="The METAR observation day (e.g. 16)."
                                Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
                                CommandParameter="{Binding $self.Content}">
                                {day}
                            </Button>
                            <Button
								Theme="{StaticResource DarkVariable}"
								ToolTip.Tip="The METAR observation time (e.g. 0153)."
								Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
								CommandParameter="{Binding $self.Content}">
								{time}
							</Button>
							<Button
								Theme="{StaticResource DarkVariable}"
								ToolTip.Tip="The hour portion of the METAR observation time."
								Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
								CommandParameter="{Binding $self.Content}">
								{hour}
							</Button>
							<Button
								Theme="{StaticResource DarkVariable}"
								ToolTip.Tip="The minute portion of the METAR observation time."
								Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
								CommandParameter="{Binding $self.Content}">
								{minute}
							</Button>
							<Button
								Theme="{StaticResource DarkVariable}"
								ToolTip.Tip="Inserts the word &quot;SPECIAL&quot; if the METAR observation time is different than the Routine Observation Time."
								Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
								CommandParameter="{Binding $self.Content}">
								{special}
							</Button>
                            <Button
                                Theme="{StaticResource DarkVariable}"
                                ToolTip.Tip="Inserts the word &quot;SPECI&quot; or &quot;METAR&quot; based on whether the observation is considered special (if the observation time is different from the Routine Observation Time). This variable is for the text template only."
                                Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
                                CommandParameter="{Binding $self.Content}">
                                {type}
                            </Button>
						</WrapPanel>
					</Grid>
				</groupBox:GroupBoxControl>
			</Grid>
			<!--Wind-->
			<Grid RowDefinitions="*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Wind'}">
				<TabControl Grid.Row="0" Classes="Pages" SelectedIndex="{Binding SelectedFormattingPage, DataType=vm:FormattingViewModel, Mode=OneWay}">
					<TabItem Header="Standard">
						<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
							<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
								<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
									<TextBlock Text="Text:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding StandardWindTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
									<TextBlock Text="Voice:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding StandardWindVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The complete wind string (e.g. 25010KT). Only available as a text variable."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The direction of the wind (e.g. 25010KT would yield 250). Magnetic variation is applied."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind__dir}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The speed of the wind (e.g. 25010KT would yield 10). The value can optionally be converted to another unit using {wind_spd|kt} or {wind_spd|mps}. In text, add :# to drop the leading zero (e.g. {wind_spd:#} yields 9 instead of 09)."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind__spd}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The wind speed unit (e.g. 25010KT yields &quot;KT&quot; in the text ATIS and &quot;knots&quot; in the voice ATIS)."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind__unit}
									</Button>
								</WrapPanel>
							</Grid>
						</groupBox:GroupBoxControl>
					</TabItem>
					<TabItem Header="Standard Gust">
						<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
							<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
								<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
									<TextBlock Text="Text:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding StandardGustWindTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
									<TextBlock Text="Voice:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding StandardGustWindVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The complete wind string (e.g. 25010KT). Only available as a text variable."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The direction of the wind (e.g. 25010KT would yield 250). Magnetic variation is applied."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind__dir}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The speed of the wind (e.g. 25010KT would yield 10). The value can optionally be converted to another unit using {wind_spd|kt} or {wind_spd|mps}. In text, add :# to drop the leading zero (e.g. {wind_spd:#} yields 9 instead of 09)."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind__spd}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The gust speed of the wind (e.g. 25010G15KT would yield 15). The value can optionally be converted to another unit using {wind_gust|kt} or {wind_gust|mps}. In text, add :# to drop the leading zero (e.g. {wind_gust:#} yields 9 instead of 09)."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind__gust}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The wind speed unit (e.g. 25010G15KT yields &quot;KT&quot; in the text ATIS and &quot;knots&quot; in the voice ATIS)."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind__unit}
									</Button>
								</WrapPanel>
							</Grid>
						</groupBox:GroupBoxControl>
					</TabItem>
					<TabItem Header="Variable">
						<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
							<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
								<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
									<TextBlock Text="Text:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding VariableWindTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
									<TextBlock Text="Voice:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding VariableWindVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The complete wind string (e.g. VRB03KT). Only available as a text variable."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The wind speed unit (e.g. VRB03KT yields &quot;KT&quot; in the text ATIS and &quot;knots&quot; in the voice ATIS)."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind__unit}
									</Button>
								</WrapPanel>
							</Grid>
						</groupBox:GroupBoxControl>
					</TabItem>
					<TabItem Header="Variable Gust">
						<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
							<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
								<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
									<TextBlock Text="Text:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding VariableGustWindTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
									<TextBlock Text="Voice:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding VariableGustWindVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The complete wind string (e.g. VRB08G15KT). Only available as a text variable."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The speed of the wind (e.g. VRB08G15KT would yield 08). The value can optionally be converted to another unit using {wind_spd|kt} or {wind_spd|mps}. In text, add :# to drop the leading zero (e.g. {wind_spd:#} yields 9 instead of 09)."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind__spd}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The speed of the wind (e.g. VRB08G15KT would yield 15). The value can optionally be converted to another unit using {wind_gust|kt} or {wind_gust|mps}. In text, add :# to drop the leading zero (e.g. {wind_gust:#} yields 9 instead of 09)."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind__gust}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The wind speed unit (e.g. VRB08G15KT yields &quot;KT&quot; in the text ATIS and &quot;knots&quot; in the voice ATIS)."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind__unit}
									</Button>
								</WrapPanel>
							</Grid>
						</groupBox:GroupBoxControl>
					</TabItem>
					<TabItem Header="Variable Direction">
						<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
							<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
								<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
									<TextBlock Text="Text:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding VariableDirectionWindTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
									<TextBlock Text="Voice:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding VariableDirectionWindVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The complete wind string (e.g. 250V280). Only available as a text variable."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The first extreme wind direction (e.g. &quot;25015G25KT 250V280&quot; would yield &quot;250&quot;). Magnetic variation is applied."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind__vmin}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The last extreme wind direction (e.g. &quot;25015G25KT 250V280&quot; would yield &quot;280&quot;). Magnetic variation is applied."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{wind__vmax}
									</Button>
								</WrapPanel>
							</Grid>
						</groupBox:GroupBoxControl>
					</TabItem>
					<TabItem Header="Calm">
						<Grid RowDefinitions="Auto,*" RowSpacing="10">
							<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
								<TextBlock VerticalAlignment="Center" ToolTip.Tip="The minimum wind speed before it is considered &quot;calm&quot;">Calm Wind Speed:</TextBlock>
								<TextBox FontFamily="{StaticResource Monospace}" Text="{Binding CalmWindSpeed, DataType=vm:FormattingViewModel}" MaxLength="3" MinWidth="60" Name="CalmWindSpeed" Theme="{StaticResource DarkTextBox}">
									<Interaction.Behaviors>
										<behaviors:TextBoxNumericOnlyBehavior/>
									</Interaction.Behaviors>
								</TextBox>
							</StackPanel>
							<groupBox:GroupBoxControl Grid.Row="1" Theme="{StaticResource GroupBoxSection}">
								<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
									<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
										<TextBlock Text="Text:" VerticalAlignment="Center"/>
										<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding CalmWindTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
									</Grid>
									<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
										<TextBlock Text="Voice:" VerticalAlignment="Center"/>
										<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding CalmWindVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
									</Grid>
									<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
										<Button
											Theme="{StaticResource DarkVariable}"
											ToolTip.Tip="The complete wind string (e.g. 25010KT). Only available as a text variable."
											Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
											CommandParameter="{Binding $self.Content}">
											{wind}
										</Button>
										<Button
											Theme="{StaticResource DarkVariable}"
											ToolTip.Tip="The direction of the wind (e.g. 25010KT would yield 250). Magnetic variation is applied."
											Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
											CommandParameter="{Binding $self.Content}">
											{wind__dir}
										</Button>
										<Button
											Theme="{StaticResource DarkVariable}"
											ToolTip.Tip="The speed of the wind (e.g. 25010KT would yield 10). The value can optionally be converted to another unit using {wind_spd|kt} or {wind_spd|mps}. In text, add :# to drop the leading zero (e.g. {wind_spd:#} yields 9 instead of 09)."
											Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
											CommandParameter="{Binding $self.Content}">
											{wind__spd}
										</Button>
										<Button
											Theme="{StaticResource DarkVariable}"
											ToolTip.Tip="The wind speed unit (e.g. 25010KT yields &quot;KT&quot; in the text ATIS and &quot;knots&quot; in the voice ATIS)."
											Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
											CommandParameter="{Binding $self.Content}">
											{wind__unit}
										</Button>
									</WrapPanel>
								</Grid>
							</groupBox:GroupBoxControl>
						</Grid>
					</TabItem>
					<TabItem Header="Variable Format">
						<StackPanel Orientation="Vertical" Spacing="10">
							<StackPanel Orientation="Vertical" Spacing="6">
								<TextBlock TextWrapping="Wrap" Text="Set how each wind variable is written. The Text columns apply to the text ATIS and the Voice columns to the voice ATIS."/>
								<Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
									<TextBlock Grid.Row="0" Grid.Column="0" Foreground="#B4B4B4" Text="Style"/>
									<TextBlock Grid.Row="0" Grid.Column="1" Foreground="#B4B4B4" Text="Result"/>
									<TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Text="Default"/>
									<TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="Digits in the text ATIS, digit by digit in the voice ATIS. The speed is read as a whole number if group format is on."/>
									<TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Text="Digits"/>
									<TextBlock Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="25"/>
									<TextBlock Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Text="Serial"/>
									<TextBlock Grid.Row="3" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="TWO FIVE"/>
									<TextBlock Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Text="Group"/>
									<TextBlock Grid.Row="4" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="TWENTY-FIVE"/>
								</Grid>
								<TextBlock TextWrapping="Wrap" Foreground="#B4B4B4" Text="The suffix is added after the value exactly as typed, so start it with a space if you want one."/>
							</StackPanel>
							<DataGrid MaxHeight="230" SelectionMode="Single" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding WindVariableFormats, DataType=vm:FormattingViewModel}">
								<Interaction.Behaviors>
									<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="WindVariableFormats"/>
								</Interaction.Behaviors>
								<DataGrid.Columns>
									<DataGridTextColumn Header="Variable" Width="120" IsReadOnly="True" Binding="{Binding Key, DataType=models:VariableFormatMeta}"/>
									<DataGridTemplateColumn Header="Text style" Width="110">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<TextBlock Text="{Binding TextStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
										<DataGridTemplateColumn.CellEditingTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<ComboBox Classes="Dark" HorizontalAlignment="Stretch" SelectedItem="{Binding TextStyle}">
													<x:String>Default</x:String>
													<x:String>Digits</x:String>
													<x:String>Serial</x:String>
													<x:String>Group</x:String>
												</ComboBox>
											</DataTemplate>
										</DataGridTemplateColumn.CellEditingTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Header="Text suffix" Width="1*" Binding="{Binding TextSuffix, DataType=models:VariableFormatMeta}"/>
									<DataGridTemplateColumn Header="Voice style" Width="110">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<TextBlock Text="{Binding VoiceStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
										<DataGridTemplateColumn.CellEditingTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<ComboBox Classes="Dark" HorizontalAlignment="Stretch" SelectedItem="{Binding VoiceStyle}">
													<x:String>Default</x:String>
													<x:String>Digits</x:String>
													<x:String>Serial</x:String>
													<x:String>Group</x:String>
												</ComboBox>
											</DataTemplate>
										</DataGridTemplateColumn.CellEditingTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Header="Voice suffix" Width="1*" Binding="{Binding VoiceSuffix, DataType=models:VariableFormatMeta}"/>
								</DataGrid.Columns>
							</DataGrid>
						</StackPanel>
					</TabItem>
				</TabControl>
			</Grid>
			<!--Visibility-->
			<Grid IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Visibility'}">
				<TabControl Classes="Pages" SelectedIndex="{Binding SelectedFormattingPage, DataType=vm:FormattingViewModel, Mode=OneWay}">
					<TabItem Header="Template">
						<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
							<Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
								<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
									<TextBlock Text="Text:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding VisibilityTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
									<TextBlock Text="Voice:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding VisibilityVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The prevailing visibility (e.g. &quot;5SM&quot; or &quot;5000&quot;)"
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{visibility}
									</Button>
								</WrapPanel>
								<TextBlock Grid.Row="3" TextWrapping="Wrap" Opacity="0.8" IsVisible="{Binding !SelectedStation.IsFaaAtis, DataType=vm:FormattingViewModel, FallbackValue=False}" Text="CAVOK does not use the template. Its text and voice are set in the CAVOK fields on the ICAO Formatting tab."/>
							</Grid>
						</groupBox:GroupBoxControl>
					</TabItem>
					<TabItem Header="ICAO Formatting" IsVisible="{Binding !SelectedStation.IsFaaAtis, DataType=vm:FormattingViewModel, FallbackValue=False}">
						<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
							<Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="0,0,10,0">
								<TextBlock Grid.Row="0" Margin="0,0,0,10" TextWrapping="Wrap" Text="Choose how a visibility in meters is shown in the text ATIS and spoken in the voice ATIS."/>
								<TextBlock Grid.Row="1" Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.8" Text="Each row applies at or above its value, up to the next row."/>
																		<DataGrid Grid.Row="2" x:Name="VisibilityFormatRules" MinHeight="100" SelectionMode="Single" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding VisibilityFormatRules, DataType=vm:FormattingViewModel}">
										<Interaction.Behaviors>
											<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="VisibilityFormatRules"/>
										</Interaction.Behaviors>
										<DataGrid.Columns>
											<DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="At or above (m)" Width="140" IsReadOnly="False" Binding="{Binding FromMeters, DataType=models:VisibilityFormatRule}"/>
											<DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="Text" Width="1*" IsReadOnly="False" Binding="{Binding Text, DataType=models:VisibilityFormatRule}"/>
											<DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="Voice" Width="1*" IsReadOnly="False" Binding="{Binding Voice, DataType=models:VisibilityFormatRule}"/>
										</DataGrid.Columns>
									</DataGrid>
								<Grid Grid.Row="3" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
									<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
										<TextBlock VerticalAlignment="Center" Opacity="0.8" Text="Insert into selected cell:"/>
										<Button Theme="{StaticResource DarkVariable}" ToolTip.Tip="Text only. The visibility as reported in the METAR (e.g. 0800)." Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}" CommandParameter="{Binding $self.Content}">{raw}</Button>
										<Button Theme="{StaticResource DarkVariable}" ToolTip.Tip="The visibility in meters. Shown as digits in the text ATIS (e.g. 800) and spoken in words in the voice ATIS (e.g. eight hundred)." Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}" CommandParameter="{Binding $self.Content}">{m}</Button>
										<Button Theme="{StaticResource DarkVariable}" ToolTip.Tip="The visibility in kilometers (e.g. 7 or 6.5)." Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}" CommandParameter="{Binding $self.Content}">{km}</Button>
									</StackPanel>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
										<Button Theme="{StaticResource Dark}" Height="28" MinWidth="80" Command="{Binding DeleteVisibilityFormatRuleCommand, DataType=vm:FormattingViewModel}" CommandParameter="{Binding #VisibilityFormatRules.SelectedItem}" IsEnabled="{Binding #VisibilityFormatRules.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">Delete</Button>
										<Button Theme="{StaticResource Dark}" Height="28" MinWidth="80" Command="{Binding AddVisibilityFormatRuleCommand, DataType=vm:FormattingViewModel}">Add New</Button>
									</StackPanel>
								</Grid>
								<Grid Grid.Row="4" Margin="0,16,0,0" ColumnDefinitions="*,*" ColumnSpacing="10">
									<StackPanel Grid.Column="0" Orientation="Vertical" Spacing="4">
										<TextBlock Text="CAVOK (Text ATIS):"/>
										<TextBox FontFamily="{StaticResource Monospace}" Text="{Binding VisibilityCavokText, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"/>
									</StackPanel>
									<StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4">
										<TextBlock Text="CAVOK (Voice ATIS):"/>
										<TextBox FontFamily="{StaticResource Monospace}" Text="{Binding VisibilityCavokVoice, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"/>
									</StackPanel>
								</Grid>
								<StackPanel Grid.Row="5" Orientation="Vertical" Spacing="6" Margin="0,16,0,0">
									<Grid ColumnDefinitions="90,110,*">
										<TextBlock Grid.Column="0" Opacity="0.7" Text="Preview"/>
										<TextBlock Grid.Column="1" Opacity="0.7" Text="Text ATIS"/>
										<TextBlock Grid.Column="2" Opacity="0.7" Text="Voice ATIS"/>
									</Grid>
									<ItemsControl ItemsSource="{Binding VisibilityFormatRulesPreview, DataType=vm:FormattingViewModel}">
										<ItemsControl.ItemTemplate>
											<DataTemplate DataType="models:VisibilityFormatPreview">
												<Grid ColumnDefinitions="90,110,*" Margin="0,0,0,2">
													<TextBlock Grid.Column="0" FontFamily="{StaticResource Monospace}" Text="{Binding Metar}"/>
													<TextBlock Grid.Column="1" FontFamily="{StaticResource Monospace}" TextWrapping="Wrap" Text="{Binding Text}"/>
													<TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding Voice}"/>
												</Grid>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Grid>
						</groupBox:GroupBoxControl>
					</TabItem>
					<TabItem Header="Direction" IsVisible="{Binding !SelectedStation.IsFaaAtis, DataType=vm:FormattingViewModel, FallbackValue=False}">
						<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
							<StackPanel Orientation="Vertical" Spacing="14">
								<TextBlock TextWrapping="Wrap" Text="A METAR can report a lower visibility in one direction, for example 7000 4000E means 7000 m overall and 4000 m to the east. Set the wording used for each direction code."/>
								<TextBlock TextWrapping="Wrap" Opacity="0.8" Text="Text is shown in the text ATIS (7000 4000E). Voice is spoken in the voice ATIS (seven kilometers and to the east four thousand meters)."/>
								<DataGrid MaxHeight="300" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding VisibilityDirections, DataType=vm:FormattingViewModel}">
									<Interaction.Behaviors>
										<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="VisibilityDirections"/>
									</Interaction.Behaviors>
									<DataGrid.Columns>
										<DataGridTextColumn Header="METAR" Width="100" IsReadOnly="True" Binding="{Binding Key, DataType=models:VisibilityDirectionMeta}"/>
										<DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="Text" Width="1*" IsReadOnly="False" Binding="{Binding Text, DataType=models:VisibilityDirectionMeta}"/>
										<DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="Voice" Width="2*" IsReadOnly="False" Binding="{Binding Voice, DataType=models:VisibilityDirectionMeta}"/>
									</DataGrid.Columns>
								</DataGrid>
							</StackPanel>
						</groupBox:GroupBoxControl>
					</TabItem>
					<TabItem Header="Fractions (Voice)" IsVisible="{Binding SelectedStation.IsFaaAtis, DataType=vm:FormattingViewModel, FallbackValue=False}">
						<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
							<DataGrid SelectionMode="Single" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding VisibilityFractionVoice, DataType=vm:FormattingViewModel}">
								<Interaction.Behaviors>
									<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="VisibilityFractionVoice"/>
								</Interaction.Behaviors>
								<DataGrid.Columns>
									<DataGridTextColumn Header="METAR" Width="140" IsReadOnly="True" Binding="{Binding Key, DataType=models:TextOverrideMeta}"/>
									<DataGridTextColumn Header="Spoken" Width="1*" IsReadOnly="False" Binding="{Binding Text, DataType=models:TextOverrideMeta}"/>
								</DataGrid.Columns>
							</DataGrid>
						</groupBox:GroupBoxControl>
					</TabItem>
				</TabControl>
			</Grid>
            <!--Runway Visual Range-->
			<Grid RowDefinitions="*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Runway Visual Range'}">
				<TabControl Grid.Row="0" Classes="Pages" SelectedIndex="{Binding SelectedFormattingPage, DataType=vm:FormattingViewModel, Mode=OneWay}">
					<TabItem Header="Voice">
						<ScrollViewer VerticalScrollBarVisibility="Auto">
							<StackPanel Spacing="20" Margin="0,0,10,0">
								<groupBox:GroupBoxControl Header="Runway Visual Range" Theme="{StaticResource GroupBoxSection}">
									<Grid ColumnDefinitions="130,*">
										<TextBlock Grid.Column="0" VerticalAlignment="Center" ToolTip.Tip="The spoken text used to announce runway visual range, e.g. R-V-R or Runway Visual Range">Spoken text:</TextBlock>
										<TextBox FontFamily="{StaticResource Monospace}" Grid.Column="1" Text="{Binding RvrSpokenText, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"/>
									</Grid>
								</groupBox:GroupBoxControl>
								<groupBox:GroupBoxControl Header="Tendencies" Theme="{StaticResource GroupBoxSection}">
									<StackPanel Orientation="Vertical" Spacing="10">
										<Grid ColumnDefinitions="130,*">
											<TextBlock Grid.Column="0" VerticalAlignment="Center" ToolTip.Tip="The spoken text if the tendency is N">Neutral (N):</TextBlock>
											<TextBox FontFamily="{StaticResource Monospace}" Grid.Column="1" Text="{Binding RvrTendencyNeutralText, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"/>
										</Grid>
										<Grid ColumnDefinitions="130,*">
											<TextBlock Grid.Column="0" VerticalAlignment="Center" ToolTip.Tip="The spoken text if the tendency is U">Going Up (U):</TextBlock>
											<TextBox FontFamily="{StaticResource Monospace}" Grid.Column="1" Text="{Binding RvrTendencyGoingUpText, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"/>
										</Grid>
										<Grid ColumnDefinitions="130,*">
											<TextBlock Grid.Column="0" VerticalAlignment="Center" ToolTip.Tip="The spoken text if the tendency is D">Going Down (D):</TextBlock>
											<TextBox FontFamily="{StaticResource Monospace}" Grid.Column="1" Text="{Binding RvrTendencyGoingDownText, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"/>
										</Grid>
									</StackPanel>
								</groupBox:GroupBoxControl>
								<groupBox:GroupBoxControl Header="Phrases" Theme="{StaticResource GroupBoxSection}">
									<StackPanel Orientation="Vertical" Spacing="10">
										<TextBlock TextWrapping="Wrap" Text="Use {value} for a single distance and {min} / {max} for variable ranges."/>
										<DataGrid MaxHeight="300" SelectionMode="Single" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding RvrVoicePhrases, DataType=vm:FormattingViewModel}">
									<Interaction.Behaviors>
										<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="RvrVoicePhrases"/>
									</Interaction.Behaviors>
									<DataGrid.Columns>
										<DataGridTextColumn Header="Phrase" Width="260" IsReadOnly="True" Binding="{Binding Key, DataType=models:TextOverrideMeta}"/>
										<DataGridTextColumn Header="Spoken" Width="1*" IsReadOnly="False" Binding="{Binding Text, DataType=models:TextOverrideMeta}"/>
									</DataGrid.Columns>
								</DataGrid>
									</StackPanel>
								</groupBox:GroupBoxControl>
							</StackPanel>
						</ScrollViewer>
					</TabItem>
					<TabItem Header="Text">
						<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
								<DataGrid GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding RvrTendencyTexts, DataType=vm:FormattingViewModel}">
									<Interaction.Behaviors>
										<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="RvrTendencyTexts"/>
									</Interaction.Behaviors>
									<DataGrid.Columns>
										<DataGridTextColumn Header="Code" Width="140" IsReadOnly="True" Binding="{Binding Key, DataType=models:TextOverrideMeta}"/>
										<DataGridTextColumn Header="Text" Width="1*" IsReadOnly="False" Binding="{Binding Text, DataType=models:TextOverrideMeta}"/>
									</DataGrid.Columns>
								</DataGrid>
							</groupBox:GroupBoxControl>
					</TabItem>
				</TabControl>
			</Grid>
			<!--Weather-->
			<Grid RowDefinitions="*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Weather'}">
				<TabControl Grid.Row="0" Classes="Pages" SelectedIndex="{Binding SelectedFormattingPage, DataType=vm:FormattingViewModel, Mode=OneWay}">
					<TabItem Header="Template">
						<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
							<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
								<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
									<TextBlock Text="Text:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding PresentWeatherTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
									<TextBlock Text="Voice:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding PresentWeatherVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The present weather groups from the METAR (e.g. &quot;SHRA BR&quot;)"
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{weather}
									</Button>
								</WrapPanel>
							</Grid>
						</groupBox:GroupBoxControl>
					</TabItem>
					<TabItem Header="Recent Weather">
						<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
							<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
								<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
									<TextBlock Text="Text:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding RecentWeatherTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
									<TextBlock Text="Voice:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding RecentWeatherVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The recent weather groups from the METAR (e.g. &quot;SHRA BR&quot;)"
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{weather}
									</Button>
								</WrapPanel>
							</Grid>
						</groupBox:GroupBoxControl>
					</TabItem>
					<TabItem Header="Weather Descriptors">
						<Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <Grid Grid.Row="0" HorizontalAlignment="Stretch" ColumnDefinitions="*,5,Auto">
                                <TextBox Grid.Column="0" Theme="{StaticResource DarkTextBox}" Watermark="Search..." Text="{Binding PresentWeatherSearchTerm, DataType=vm:FormattingViewModel}">
                                    <Interaction.Behaviors>
                                        <behaviors:TextBoxUppercaseBehavior/>
                                    </Interaction.Behaviors>
                                </TextBox>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                                    <CheckBox IsChecked="{Binding PresentWeatherFilterAcronym, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}">Acronym</CheckBox>
                                    <CheckBox IsChecked="{Binding PresentWeatherFilterText, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}">Text</CheckBox>
                                    <CheckBox IsChecked="{Binding PresentWeatherFilterSpoken, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}">Spoken</CheckBox>
                                </StackPanel>
                            </Grid>
                            <DataGrid Grid.Row="1" Name="WeatherDescriptors" SelectionMode="Extended" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding FilteredPresentWeatherTypes, DataType=vm:FormattingViewModel}">
								<Interaction.Behaviors>
									<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="PresentWeatherTypes"/>
								</Interaction.Behaviors>
								<DataGrid.Styles>
									<Style Selector="DataGridCell TextBlock">
										<Setter Property="TextWrapping" Value="Wrap"/>
									</Style>
									<Style Selector="DataGrid:focus DataGridCell:current /template/ Grid#FocusVisual">
										<Setter Property="IsVisible" Value="False" />
									</Style>
								</DataGrid.Styles>
								<DataGrid.Columns>
									<DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="Acronym" Width="140" Binding="{Binding Key, DataType=models:PresentWeatherMeta}" IsReadOnly="True"/>
									<DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="Text" Width="140" Binding="{Binding Text, DataType=models:PresentWeatherMeta}" IsReadOnly="False"/>
									<DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="Spoken" Width="1*" Binding="{Binding Spoken, DataType=models:PresentWeatherMeta}" IsReadOnly="False"/>
								</DataGrid.Columns>
							</DataGrid>
						</Grid>
					</TabItem>
				</TabControl>
			</Grid>
			<!--Clouds-->
			<Grid RowDefinitions="*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Clouds'}">
				<TabControl Grid.Row="0" Classes="Pages" SelectedIndex="{Binding SelectedFormattingPage, DataType=vm:FormattingViewModel, Mode=OneWay}">
					<TabItem Header="Template">
						<Grid>
							<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
								<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
									<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
										<TextBlock Text="Text:" VerticalAlignment="Center"/>
										<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding CloudsTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
									</Grid>
									<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
										<TextBlock Text="Voice:" VerticalAlignment="Center"/>
										<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding CloudsVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
									</Grid>
									<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
										<Button
											Theme="{StaticResource DarkVariable}"
											ToolTip.Tip="The cloud layer groups from the METAR (e.g. &quot;SCT150 FEW200&quot;)"
											Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
											CommandParameter="{Binding $self.Content}">
											{clouds}
										</Button>
									</WrapPanel>
								</Grid>
							</groupBox:GroupBoxControl>
						</Grid>
					</TabItem>
                    <TabItem Header="Options">
                        <StackPanel Orientation="Vertical" Spacing="10">
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="Ceiling"/>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="15,0,0,0">
                                    <Label VerticalAlignment="Center" Content="Ceiling cloud types:" Width="170"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                    <CheckBox Content="SCT" Theme="{StaticResource CheckBox}">
                                        <Interaction.Behaviors>
                                            <behaviors:CheckboxToListBehavior ItemsSource="{Binding SelectedCeilingLayers, DataType=vm:FormattingViewModel}" Value="SCT"/>
                                        </Interaction.Behaviors>
                                    </CheckBox>
                                    <CheckBox Content="BKN" Theme="{StaticResource CheckBox}">
                                        <Interaction.Behaviors>
                                            <behaviors:CheckboxToListBehavior ItemsSource="{Binding SelectedCeilingLayers, DataType=vm:FormattingViewModel}" Value="BKN"/>
                                        </Interaction.Behaviors>
                                    </CheckBox>
                                    <CheckBox Content="OVC" Theme="{StaticResource CheckBox}">
                                        <Interaction.Behaviors>
                                            <behaviors:CheckboxToListBehavior ItemsSource="{Binding SelectedCeilingLayers, DataType=vm:FormattingViewModel}" Value="OVC"/>
                                        </Interaction.Behaviors>
                                    </CheckBox>
                                </StackPanel>
                                </StackPanel>
                                <CheckBox Margin="15,0,0,0" IsChecked="{Binding CloudsIdentifyCeilingLayer, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}">Prefix ceiling layer in voice ATIS with "ceiling"</CheckBox>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="15,0,0,0">
                                    <CheckBox Name="PrefixCeilingTextAtis" IsChecked="{Binding CloudsIdentifyCeilingLayerTextAtis, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}">Prefix the ceiling layer in the text ATIS with:</CheckBox>
                                    <TextBox FontFamily="{StaticResource Monospace}" Width="100" IsEnabled="{Binding #PrefixCeilingTextAtis.IsChecked}" Text="{Binding CloudCeilingLayerPrefixTextAtis, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="Units"/>
                                <StackPanel Orientation="Horizontal" Spacing="30" Margin="15,0,0,0">
                                    <CheckBox Name="CloudToMetric" IsChecked="{Binding CloudsConvertToMetric, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}">Convert cloud layer altitude to metric</CheckBox>
                                <CheckBox IsChecked="{Binding CloudHeightAltitudeInHundreds, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}" IsEnabled="{Binding !#CloudToMetric.IsChecked}" ToolTip.Tip="Cloud height will be displayed in feet instead of hundreds of feet, for example FEW010 will be shown as FEW1000">Display cloud height in feet in the text ATIS</CheckBox>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock FontWeight="SemiBold" Text="Undetermined height (///)"/>
                                <Grid Margin="15,0,0,0" ColumnDefinitions="170,10,*,20,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                    <TextBlock Grid.Row="0" Grid.Column="2" Opacity="0.7" Text="Text ATIS"/>
                                    <TextBlock Grid.Row="0" Grid.Column="4" Opacity="0.7" Text="Voice ATIS"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" ToolTip.Tip="Replaces {altitude} if the cloud layer height is ///">Cloud layer</TextBlock>
                                    <TextBox FontFamily="{StaticResource Monospace}" Grid.Row="1" Grid.Column="2" Text="{Binding UndeterminedLayerAltitudeText, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"/>
                                    <TextBox FontFamily="{StaticResource Monospace}" Grid.Row="1" Grid.Column="4" Text="{Binding UndeterminedLayerAltitudeVoice, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" ToolTip.Tip="Replaces {altitude} if the vertical visibility is ///">Vertical visibility</TextBlock>
                                    <TextBox FontFamily="{StaticResource Monospace}" Grid.Row="2" Grid.Column="2" Text="{Binding UndeterminedVerticalVisibilityText, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"/>
                                    <TextBox FontFamily="{StaticResource Monospace}" Grid.Row="2" Grid.Column="4" Text="{Binding UndeterminedVerticalVisibilityVoice, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>
					<TabItem Header="Cloud Types">
						<Grid RowDefinitions="Auto,*" RowSpacing="10">
							<Button Grid.Row="0" HorizontalAlignment="Right" Theme="{StaticResource Dark}" Content="Template variables">
								<Button.Flyout>
									<Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="variables">
										<Grid ColumnDefinitions="110,10,*" MaxWidth="560" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
											<TextBlock Grid.Row="0" Grid.Column="0" FontFamily="{StaticResource Monospace}" Text="{}{altitude}"/>
											<TextBlock Grid.Row="0" Grid.Column="2" TextWrapping="Wrap" Opacity="0.8" Text="Cloud base height. Replaced with the undetermined text when the height is ///."/>
											<TextBlock Grid.Row="1" Grid.Column="0" FontFamily="{StaticResource Monospace}" Text="{}{altitude:N}"/>
											<TextBlock Grid.Row="1" Grid.Column="2" TextWrapping="Wrap" Opacity="0.8" Text="Text ATIS only. Height zero-padded to N digits, for example {altitude:2} gives 03 for 300 ft."/>
											<TextBlock Grid.Row="2" Grid.Column="0" FontFamily="{StaticResource Monospace}" Text="{}{convective}"/>
											<TextBlock Grid.Row="2" Grid.Column="2" TextWrapping="Wrap" Opacity="0.8" Text="CB or TCU type, if reported. Spoken form is set in Convective Cloud Types."/>
											<TextBlock Grid.Row="3" Grid.Column="0" FontFamily="{StaticResource Monospace}" Text="{}{amount}"/>
											<TextBlock Grid.Row="3" Grid.Column="2" TextWrapping="Wrap" Opacity="0.8" Text="Undetermined (UND) row only. The layer amount, such as FEW or BKN."/>
											<TextBlock Grid.Row="4" Grid.Column="0" FontFamily="{StaticResource Monospace}" Text="{}{feet}"/>
											<TextBlock Grid.Row="4" Grid.Column="2" TextWrapping="Wrap" Opacity="0.8" Text="&quot;feet&quot; when the height is known, and empty when it is ///, so the unit is dropped with the height."/>
										</Grid>
									</Flyout>
								</Button.Flyout>
							</Button>
	<DataGrid Grid.Row="1" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding CloudTypes, DataType=vm:FormattingViewModel}">
								<Interaction.Behaviors>
									<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="CloudTypes"/>
								</Interaction.Behaviors>
								<DataGrid.Styles>
									<Style Selector="DataGrid:focus DataGridCell:current /template/ Grid#FocusVisual">
										<Setter Property="IsVisible" Value="False" />
									</Style>
								</DataGrid.Styles>
								<DataGrid.Columns>
									<DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="Acronym" Width="150" IsReadOnly="True" Binding="{Binding Acronym, DataType=models:CloudTypeMeta}"/>
									<DataGridTemplateColumn Header="Spoken" Width="1*">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="models:CloudTypeMeta">
												<TextBlock FontFamily="{StaticResource Monospace}" Text="{Binding Spoken}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,6"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
										<DataGridTemplateColumn.CellEditingTemplate>
											<DataTemplate DataType="models:CloudTypeMeta">
												<TextBox FontFamily="{StaticResource Monospace}" Text="{Binding Spoken}" TextWrapping="Wrap" VerticalAlignment="Center"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellEditingTemplate>
									</DataGridTemplateColumn>
									<DataGridTemplateColumn Header="Text" Width="1*">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="models:CloudTypeMeta">
												<TextBlock FontFamily="{StaticResource Monospace}" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,6"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
										<DataGridTemplateColumn.CellEditingTemplate>
											<DataTemplate DataType="models:CloudTypeMeta">
												<TextBox FontFamily="{StaticResource Monospace}" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellEditingTemplate>
									</DataGridTemplateColumn>
								</DataGrid.Columns>
							</DataGrid>
						</Grid>
					</TabItem>
					<TabItem Header="Convective Cloud Types">
                        <StackPanel Orientation="Vertical" Spacing="10">
                            <DataGrid GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding ConvectiveCloudTypes, DataType=vm:FormattingViewModel}">
							    <Interaction.Behaviors>
								    <behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="ConvectiveCloudTypes"/>
							    </Interaction.Behaviors>
							    <DataGrid.Styles>
								    <Style Selector="DataGrid:focus DataGridCell:current /template/ Grid#FocusVisual">
									    <Setter Property="IsVisible" Value="False" />
								    </Style>
							    </DataGrid.Styles>
							    <DataGrid.Columns>
								    <DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="Acronym" Width="1*" IsReadOnly="True" Binding="{Binding Key, DataType=models:ConvectiveCloudTypeMeta}"/>
								    <DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="Spoken" Width="1*" IsReadOnly="False" Binding="{Binding Value, DataType=models:ConvectiveCloudTypeMeta}"/>
								    <DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="Text" Width="1*" IsReadOnly="False" Binding="{Binding Text, DataType=models:ConvectiveCloudTypeMeta}"/>
							    </DataGrid.Columns>
						    </DataGrid>
                            <StackPanel Orientation="Vertical" Spacing="5" IsVisible="{Binding !SelectedStation.IsFaaAtis, DataType=vm:FormattingViewModel, FallbackValue=False}">
                                <TextBlock Text="Automatic CB Detection" Margin="0,10,0,0" ToolTip.Tip="When //////CB is presented in the METAR"/>
                                <TextBlock ToolTip.Tip="The value presented in the text ATIS">Text:</TextBlock>
                                <TextBox Text="{Binding AutomaticCbDetectionText, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}" Watermark="The value presented in the text ATIS" FontFamily="{StaticResource Monospace}"/>
                                <TextBlock ToolTip.Tip="The spoken value in the voice ATIS">Voice:</TextBlock>
                                <TextBox Text="{Binding AutomaticCbDetectionVoice, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}" Watermark="The spoken value in the voice ATIS" FontFamily="{StaticResource Monospace}"/>
                            </StackPanel>
                        </StackPanel>
					</TabItem>
					<TabItem Header="Variable Format">
						<StackPanel Orientation="Vertical" Spacing="10">
							<StackPanel Orientation="Vertical" Spacing="6">
								<TextBlock TextWrapping="Wrap" Text="Set how the cloud height is written. The Text columns apply to the text ATIS and the Voice columns to the voice ATIS."/>
								<Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
									<TextBlock Grid.Row="0" Grid.Column="0" Foreground="#B4B4B4" Text="Style"/>
									<TextBlock Grid.Row="0" Grid.Column="1" Foreground="#B4B4B4" Text="Result"/>
									<TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Text="Default"/>
									<TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="Digits in the text ATIS, words in the voice ATIS."/>
									<TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Text="Digits"/>
									<TextBlock Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="3000"/>
									<TextBlock Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Text="Serial"/>
									<TextBlock Grid.Row="3" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="THREE ZERO ZERO ZERO"/>
									<TextBlock Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Text="Group"/>
									<TextBlock Grid.Row="4" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="THREE THOUSAND"/>
								</Grid>
								<TextBlock TextWrapping="Wrap" Foreground="#B4B4B4" Text="The suffix is added after the value exactly as typed, so start it with a space if you want one."/>
							</StackPanel>
							<DataGrid MaxHeight="230" SelectionMode="Single" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding CloudAltitudeFormats, DataType=vm:FormattingViewModel}">
								<Interaction.Behaviors>
									<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="CloudAltitudeFormats"/>
								</Interaction.Behaviors>
								<DataGrid.Columns>
									<DataGridTextColumn Header="Variable" Width="120" IsReadOnly="True" Binding="{Binding Key, DataType=models:VariableFormatMeta}"/>
									<DataGridTemplateColumn Header="Text style" Width="110">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<TextBlock Text="{Binding TextStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
										<DataGridTemplateColumn.CellEditingTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<ComboBox Classes="Dark" HorizontalAlignment="Stretch" SelectedItem="{Binding TextStyle}">
													<x:String>Default</x:String>
													<x:String>Digits</x:String>
													<x:String>Serial</x:String>
													<x:String>Group</x:String>
												</ComboBox>
											</DataTemplate>
										</DataGridTemplateColumn.CellEditingTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Header="Text suffix" Width="1*" Binding="{Binding TextSuffix, DataType=models:VariableFormatMeta}"/>
									<DataGridTemplateColumn Header="Voice style" Width="110">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<TextBlock Text="{Binding VoiceStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
										<DataGridTemplateColumn.CellEditingTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<ComboBox Classes="Dark" HorizontalAlignment="Stretch" SelectedItem="{Binding VoiceStyle}">
													<x:String>Default</x:String>
													<x:String>Digits</x:String>
													<x:String>Serial</x:String>
													<x:String>Group</x:String>
												</ComboBox>
											</DataTemplate>
										</DataGridTemplateColumn.CellEditingTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Header="Voice suffix" Width="1*" Binding="{Binding VoiceSuffix, DataType=models:VariableFormatMeta}"/>
								</DataGrid.Columns>
							</DataGrid>
						</StackPanel>
					</TabItem>
				</TabControl>
			</Grid>
			<!--Temperature-->
			<Grid RowDefinitions="*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Temperature'}">
				<TabControl Grid.Row="0" Classes="Pages" SelectedIndex="{Binding SelectedFormattingPage, DataType=vm:FormattingViewModel, Mode=OneWay}">
					<TabItem Header="Template">
				<Grid RowDefinitions="Auto,*" RowSpacing="10">
					<StackPanel Grid.Row="0" Orientation="Vertical" Spacing="5">
						<CheckBox IsChecked="{Binding TemperatureUsePlusPrefix, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}" ToolTip.Tip="If enabled, positive temperature values will be prefixed with the world &quot;plus&quot; in the voice ATIS (e.g. temperature PLUS two five)">Prefix positive temperature with &quot;plus&quot; in voice ATIS.</CheckBox>
						<CheckBox IsChecked="{Binding TemperatureSpeakLeadingZero, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}" ToolTip.Tip="If enabled, the leading zero will be spoken (e.g. temperature zero six).">Speak leading zero in voice ATIS</CheckBox>
					</StackPanel>
					<groupBox:GroupBoxControl Grid.Row="1" Theme="{StaticResource GroupBoxSection}">
						<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
							<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
								<TextBlock Text="Text:" VerticalAlignment="Center"/>
								<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding TemperatureTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
							</Grid>
							<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
								<TextBlock Text="Voice:" VerticalAlignment="Center"/>
								<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding TemperatureVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
							</Grid>
							<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
								<Button
									Theme="{StaticResource DarkVariable}"
									ToolTip.Tip="The temperature value from the METAR. In text, add :## to set the digit count, followed by M to drop the M prefix, - to replace it with a dash, or 'text' to replace it with custom text (e.g. {temp:##-} yields -05, {temp:##'MS'} yields MS05)."
									Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
									CommandParameter="{Binding $self.Content}">
									{temp}
								</Button>
								<Button
									Theme="{StaticResource DarkVariable}"
									ToolTip.Tip="The prefix symbol used to indicate a positive (+) or negative (-) value. Only applies to text ATIS."
									Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
									CommandParameter="{Binding $self.Content}">
									{prefix__symbol}
								</Button>
							</WrapPanel>
						</Grid>
					</groupBox:GroupBoxControl>
				</Grid>
					</TabItem>
					<TabItem Header="Variable Format">
						<StackPanel Orientation="Vertical" Spacing="10">
							<StackPanel Orientation="Vertical" Spacing="6">
								<TextBlock TextWrapping="Wrap" Text="Set how the temperature is written. The Text columns apply to the text ATIS and the Voice columns to the voice ATIS."/>
								<Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
									<TextBlock Grid.Row="0" Grid.Column="0" Foreground="#B4B4B4" Text="Style"/>
									<TextBlock Grid.Row="0" Grid.Column="1" Foreground="#B4B4B4" Text="Result"/>
									<TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Text="Default"/>
									<TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="Digits in the text ATIS, digit by digit in the voice ATIS."/>
									<TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Text="Digits"/>
									<TextBlock Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="15"/>
									<TextBlock Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Text="Serial"/>
									<TextBlock Grid.Row="3" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="ONE FIVE"/>
									<TextBlock Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Text="Group"/>
									<TextBlock Grid.Row="4" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="FIFTEEN"/>
								</Grid>
								<TextBlock TextWrapping="Wrap" Foreground="#B4B4B4" Text="The suffix is added after the value exactly as typed, so start it with a space if you want one."/>
							</StackPanel>
							<DataGrid MaxHeight="230" SelectionMode="Single" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding TemperatureVariableFormats, DataType=vm:FormattingViewModel}">
								<Interaction.Behaviors>
									<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="TemperatureVariableFormats"/>
								</Interaction.Behaviors>
								<DataGrid.Columns>
									<DataGridTextColumn Header="Variable" Width="120" IsReadOnly="True" Binding="{Binding Key, DataType=models:VariableFormatMeta}"/>
									<DataGridTextColumn Header="Text suffix" Width="1*" Binding="{Binding TextSuffix, DataType=models:VariableFormatMeta}"/>
									<DataGridTemplateColumn Header="Voice style" Width="110">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<TextBlock Text="{Binding VoiceStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
										<DataGridTemplateColumn.CellEditingTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<ComboBox Classes="Dark" HorizontalAlignment="Stretch" SelectedItem="{Binding VoiceStyle}">
													<x:String>Default</x:String>
													<x:String>Digits</x:String>
													<x:String>Serial</x:String>
													<x:String>Group</x:String>
												</ComboBox>
											</DataTemplate>
										</DataGridTemplateColumn.CellEditingTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Header="Voice suffix" Width="1*" Binding="{Binding VoiceSuffix, DataType=models:VariableFormatMeta}"/>
								</DataGrid.Columns>
							</DataGrid>
						</StackPanel>
					</TabItem>
				</TabControl>
			</Grid>
			<!--Dewpoint-->
			<Grid RowDefinitions="*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Dewpoint'}">
				<TabControl Grid.Row="0" Classes="Pages" SelectedIndex="{Binding SelectedFormattingPage, DataType=vm:FormattingViewModel, Mode=OneWay}">
					<TabItem Header="Template">
				<Grid RowDefinitions="Auto,*" RowSpacing="10">
					<StackPanel Grid.Row="0" Orientation="Vertical" Spacing="5">
						<CheckBox IsChecked="{Binding DewpointUsePlusPrefix, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}" ToolTip.Tip="If enabled, positive dewpoint will be prefixed with the world &quot;plus&quot; in the voice ATIS (e.g. temperature PLUS two five)">Prefix positive dewpoint with &quot;plus&quot; in voice ATIS.</CheckBox>
						<CheckBox IsChecked="{Binding DewpointSpeakLeadingZero, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}" ToolTip.Tip="If enabled, the leading zero will be spoken (e.g. dewpoint zero six).">Speak leading zero in voice ATIS</CheckBox>
					</StackPanel>
					<groupBox:GroupBoxControl Grid.Row="1" Theme="{StaticResource GroupBoxSection}">
						<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
							<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
								<TextBlock Text="Text:" VerticalAlignment="Center"/>
								<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding DewpointTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
							</Grid>
							<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
								<TextBlock Text="Voice:" VerticalAlignment="Center"/>
								<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding DewpointVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
							</Grid>
							<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
								<Button
									Theme="{StaticResource DarkVariable}"
									ToolTip.Tip="The dewpoint value from the METAR. In text, add :## to set the digit count, followed by M to drop the M prefix, - to replace it with a dash, or 'text' to replace it with custom text (e.g. {dewpoint:##-} yields -05, {dewpoint:##'MS'} yields MS05)."
									Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
									CommandParameter="{Binding $self.Content}">
									{dewpoint}
								</Button>
								<Button
									Theme="{StaticResource DarkVariable}"
									ToolTip.Tip="The prefix symbol used to indicate a positive (+) or negative (-) value. Only applies to text ATIS."
									Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
									CommandParameter="{Binding $self.Content}">
									{prefix__symbol}
								</Button>
							</WrapPanel>
						</Grid>
					</groupBox:GroupBoxControl>
				</Grid>
					</TabItem>
					<TabItem Header="Variable Format">
						<StackPanel Orientation="Vertical" Spacing="10">
							<StackPanel Orientation="Vertical" Spacing="6">
								<TextBlock TextWrapping="Wrap" Text="Set how the dewpoint is written. The Text columns apply to the text ATIS and the Voice columns to the voice ATIS."/>
								<Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
									<TextBlock Grid.Row="0" Grid.Column="0" Foreground="#B4B4B4" Text="Style"/>
									<TextBlock Grid.Row="0" Grid.Column="1" Foreground="#B4B4B4" Text="Result"/>
									<TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Text="Default"/>
									<TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="Digits in the text ATIS, digit by digit in the voice ATIS."/>
									<TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Text="Digits"/>
									<TextBlock Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="15"/>
									<TextBlock Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Text="Serial"/>
									<TextBlock Grid.Row="3" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="ONE FIVE"/>
									<TextBlock Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Text="Group"/>
									<TextBlock Grid.Row="4" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="FIFTEEN"/>
								</Grid>
								<TextBlock TextWrapping="Wrap" Foreground="#B4B4B4" Text="The suffix is added after the value exactly as typed, so start it with a space if you want one."/>
							</StackPanel>
							<DataGrid MaxHeight="230" SelectionMode="Single" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding DewpointVariableFormats, DataType=vm:FormattingViewModel}">
								<Interaction.Behaviors>
									<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="DewpointVariableFormats"/>
								</Interaction.Behaviors>
								<DataGrid.Columns>
									<DataGridTextColumn Header="Variable" Width="120" IsReadOnly="True" Binding="{Binding Key, DataType=models:VariableFormatMeta}"/>
									<DataGridTextColumn Header="Text suffix" Width="1*" Binding="{Binding TextSuffix, DataType=models:VariableFormatMeta}"/>
									<DataGridTemplateColumn Header="Voice style" Width="110">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<TextBlock Text="{Binding VoiceStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
										<DataGridTemplateColumn.CellEditingTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<ComboBox Classes="Dark" HorizontalAlignment="Stretch" SelectedItem="{Binding VoiceStyle}">
													<x:String>Default</x:String>
													<x:String>Digits</x:String>
													<x:String>Serial</x:String>
													<x:String>Group</x:String>
												</ComboBox>
											</DataTemplate>
										</DataGridTemplateColumn.CellEditingTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Header="Voice suffix" Width="1*" Binding="{Binding VoiceSuffix, DataType=models:VariableFormatMeta}"/>
								</DataGrid.Columns>
							</DataGrid>
						</StackPanel>
					</TabItem>
				</TabControl>
			</Grid>
			<!--Altimeter-->
			<Grid RowDefinitions="*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Altimeter'}">
				<TabControl Grid.Row="0" Classes="Pages" SelectedIndex="{Binding SelectedFormattingPage, DataType=vm:FormattingViewModel, Mode=OneWay}">
					<TabItem Header="Template">
				<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
					<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
						<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
							<TextBlock Text="Text:" VerticalAlignment="Center"/>
							<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding AltimeterTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
						</Grid>
						<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
							<TextBlock Text="Voice:" VerticalAlignment="Center"/>
							<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding AltimeterVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
						</Grid>
						<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
							<Button
								Theme="{StaticResource DarkVariable}"
								ToolTip.Tip="The altimeter value from the METAR (e.g. 2992 or 1013)"
								Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
								CommandParameter="{Binding $self.Content}">
								{altimeter}
							</Button>
							<Button
								Theme="{StaticResource DarkVariable}"
								ToolTip.Tip="Encodes the altimeter into numeric word form (e.g. TWO NINER NINER TWO)"
								Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
								CommandParameter="{Binding $self.Content}">
								{altimeter|text}
							</Button>
							<Button
								Theme="{StaticResource DarkVariable}"
								ToolTip.Tip="Converts the altimeter value to inHg (inches mercury) and includes the decimal point (e.g. text: 29.92, voice: TWO NINER POINT NINER TWO)"
								Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
								CommandParameter="{Binding $self.Content}">
								{altimeter|inhg}
							</Button>
							<Button
								Theme="{StaticResource DarkVariable}"
								ToolTip.Tip="Converts the altimeter value to hPa (hectopascal)"
								Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
								CommandParameter="{Binding $self.Content}">
								{altimeter|hpa}
							</Button>
							<Button
								IsVisible="{Binding !SelectedStation.IsFaaAtis, DataType=vm:FormattingViewModel, FallbackValue=False}"
								Theme="{StaticResource DarkVariable}"
								ToolTip.Tip="Aerodrome atmospheric pressure&#x0a;&#x0a;You will be asked for the field elevation in feet, which is added to the variable (e.g. {qfe|328})."
								Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
								CommandParameter="{Binding $self.Content}">
								{qfe|ELEVATION__FT}
							</Button>
						</WrapPanel>
					</Grid>
				</groupBox:GroupBoxControl>
					</TabItem>
					<TabItem Header="Variable Format">
						<StackPanel Orientation="Vertical" Spacing="10">
							<StackPanel Orientation="Vertical" Spacing="6">
								<TextBlock TextWrapping="Wrap" Text="Set how each altimeter variable is written. The Text columns apply to the text ATIS and the Voice columns to the voice ATIS."/>
								<Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="2">
									<TextBlock Grid.Row="0" Grid.Column="0" Foreground="#B4B4B4" Text="Style"/>
									<TextBlock Grid.Row="0" Grid.Column="1" Foreground="#B4B4B4" Text="Result"/>
									<TextBlock Grid.Row="1" Grid.Column="0" FontWeight="SemiBold" Text="Default"/>
									<TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Text="Digits in the text ATIS, digit by digit in the voice ATIS. The text variable is always digit by digit."/>
									<TextBlock Grid.Row="2" Grid.Column="0" FontWeight="SemiBold" Text="Digits"/>
									<TextBlock Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="1013 or 29.92"/>
									<TextBlock Grid.Row="3" Grid.Column="0" FontWeight="SemiBold" Text="Serial"/>
									<TextBlock Grid.Row="3" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="ONE ZERO ONE THREE"/>
									<TextBlock Grid.Row="4" Grid.Column="0" FontWeight="SemiBold" Text="Group"/>
									<TextBlock Grid.Row="4" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="ONE THOUSAND AND THIRTEEN"/>
									<TextBlock Grid.Row="5" Grid.Column="0" FontWeight="SemiBold" Text="NoDecimal"/>
									<TextBlock Grid.Row="5" Grid.Column="1" FontFamily="{StaticResource Monospace}" Text="2992"/>
								</Grid>
								<TextBlock TextWrapping="Wrap" Foreground="#B4B4B4" Text="The suffix is added after the value exactly as typed, so start it with a space if you want one."/>
							</StackPanel>
							<DataGrid MaxHeight="230" SelectionMode="Single" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding AltimeterVariableFormats, DataType=vm:FormattingViewModel}">
								<Interaction.Behaviors>
									<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="AltimeterVariableFormats"/>
								</Interaction.Behaviors>
								<DataGrid.Columns>
									<DataGridTextColumn Header="Variable" Width="120" IsReadOnly="True" Binding="{Binding Key, DataType=models:VariableFormatMeta}"/>
									<DataGridTemplateColumn Header="Text style" Width="110">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<TextBlock Text="{Binding TextStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
										<DataGridTemplateColumn.CellEditingTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<ComboBox Classes="Dark" HorizontalAlignment="Stretch" SelectedItem="{Binding TextStyle}">
													<x:String>Default</x:String>
													<x:String>Digits</x:String>
													<x:String>Serial</x:String>
													<x:String>Group</x:String>
													<x:String>NoDecimal</x:String>
												</ComboBox>
											</DataTemplate>
										</DataGridTemplateColumn.CellEditingTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Header="Text suffix" Width="1*" Binding="{Binding TextSuffix, DataType=models:VariableFormatMeta}"/>
									<DataGridTemplateColumn Header="Voice style" Width="110">
										<DataGridTemplateColumn.CellTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<TextBlock Text="{Binding VoiceStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
											</DataTemplate>
										</DataGridTemplateColumn.CellTemplate>
										<DataGridTemplateColumn.CellEditingTemplate>
											<DataTemplate DataType="models:VariableFormatMeta">
												<ComboBox Classes="Dark" HorizontalAlignment="Stretch" SelectedItem="{Binding VoiceStyle}">
													<x:String>Default</x:String>
													<x:String>Digits</x:String>
													<x:String>Serial</x:String>
													<x:String>Group</x:String>
													<x:String>NoDecimal</x:String>
												</ComboBox>
											</DataTemplate>
										</DataGridTemplateColumn.CellEditingTemplate>
									</DataGridTemplateColumn>
									<DataGridTextColumn Header="Voice suffix" Width="1*" Binding="{Binding VoiceSuffix, DataType=models:VariableFormatMeta}"/>
								</DataGrid.Columns>
							</DataGrid>
						</StackPanel>
					</TabItem>
				</TabControl>
			</Grid>
			<!--Runway Condition-->
			<Grid RowDefinitions="*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Runway Condition'}">
				<TabControl Grid.Row="0" Classes="Pages" SelectedIndex="{Binding SelectedFormattingPage, DataType=vm:FormattingViewModel, Mode=OneWay}">
					<TabItem Header="Template">
						<Grid>
							<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
								<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
									<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
										<TextBlock Text="Text:" VerticalAlignment="Center"/>
										<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding RunwayConditionText, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
									</Grid>
									<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
										<TextBlock Text="Voice:" VerticalAlignment="Center"/>
										<controls:TemplateVariableTextBox Grid.Row="1" Name="RunwayConditionVoiceTextBox" Text="{Binding RunwayConditionVoice, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
									</Grid>
									<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
										<Button
											Theme="{StaticResource DarkVariable}"
											ToolTip.Tip="The runway identifier."
											Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
											CommandParameter="{Binding $self.Content}">
											{runway}
										</Button>
										<Button
											Theme="{StaticResource DarkVariable}"
											ToolTip.Tip="The type of deposit on the runway (e.g. wet, covered with slush)."
											Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
											CommandParameter="{Binding $self.Content}">
											{deposit}
										</Button>
										<Button
											Theme="{StaticResource DarkVariable}"
											ToolTip.Tip="The depth of the deposit in millimeters or centimeters. Empty if not reported."
											Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
											CommandParameter="{Binding $self.Content}">
											{depth}
										</Button>
										<Button
											Theme="{StaticResource DarkVariable}"
											ToolTip.Tip="The estimated surface friction (e.g. good, medium to poor). Empty if not reported."
											Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
											CommandParameter="{Binding $self.Content}">
											{friction}
										</Button>
										<Button
											Theme="{StaticResource DarkVariable}"
											ToolTip.Tip="The raw runway state group as it appears in the METAR (e.g. R25/290150). Text template only."
											Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
											CommandParameter="{Binding $self.Content}">
											{raw}
										</Button>
									</WrapPanel>
								</Grid>
							</groupBox:GroupBoxControl>
						</Grid>
					</TabItem>
					<TabItem Header="Wording">
						<Grid RowDefinitions="Auto,*" RowSpacing="10">
							<TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#B4B4B4" Text="Use {value} in the depth wording to insert the depth (e.g. {value} millimeters)."/>
							<DataGrid Grid.Row="1" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding RunwayConditionTerms, DataType=vm:FormattingViewModel}">
								<Interaction.Behaviors>
									<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="RunwayConditionTerms"/>
								</Interaction.Behaviors>
								<DataGrid.Styles>
									<Style Selector="DataGridCell TextBlock">
										<Setter Property="TextWrapping" Value="Wrap" />
									</Style>
									<Style Selector="DataGridCell TextBox">
										<Setter Property="TextWrapping" Value="Wrap" />
									</Style>
									<Style Selector="DataGrid:focus DataGridCell:current /template/ Grid#FocusVisual">
										<Setter Property="IsVisible" Value="False" />
									</Style>
								</DataGrid.Styles>
								<DataGrid.Columns>
									<DataGridTextColumn Header="Term" Width="200" IsReadOnly="True" Binding="{Binding Description, DataType=models:RunwayConditionTermMeta}"/>
									<DataGridTextColumn Header="Spoken" Width="1*" IsReadOnly="False" Binding="{Binding Spoken, DataType=models:RunwayConditionTermMeta}"/>
									<DataGridTextColumn Header="Text" Width="1*" IsReadOnly="False" Binding="{Binding Text, DataType=models:RunwayConditionTermMeta}"/>
								</DataGrid.Columns>
							</DataGrid>
						</Grid>
					</TabItem>
				</TabControl>
			</Grid>
            <!--Remark Wind-->
            <Grid RowDefinitions="*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Remark Wind'}">
				<Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
					<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
						<TextBlock Text="Text:" VerticalAlignment="Center"/>
						<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding RemarkWindText, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
					</Grid>
					<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
						<TextBlock Text="Voice:" VerticalAlignment="Center"/>
						<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding RemarkWindVoice, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
					</Grid>
					<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
						<Button
							Theme="{StaticResource DarkVariable}"
							ToolTip.Tip="The height of the wind observation in feet."
							Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
							CommandParameter="{Binding $self.Content}">
							{height}
						</Button>
						<Button
							Theme="{StaticResource DarkVariable}"
							ToolTip.Tip="The wind direction in degrees, or VRB if variable."
							Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
							CommandParameter="{Binding $self.Content}">
							{dir}
						</Button>
						<Button
							Theme="{StaticResource DarkVariable}"
							ToolTip.Tip="The wind speed in knots, including any gust (e.g. 03G10)."
							Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
							CommandParameter="{Binding $self.Content}">
							{speed}
						</Button>
					</WrapPanel>
				</Grid>
			</Grid>
            <!--Automatic Observation-->
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Automatic Observation'}">
				<TextBlock Grid.Row="0" TextWrapping="Wrap" Text="Used by the [AUTO] variable. Only output when the METAR is flagged AUTO."/>
				<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
					<TextBlock Text="Text:" VerticalAlignment="Center"/>
					<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding AutoObservationText, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
				</Grid>
				<Grid RowDefinitions="Auto,Auto" Grid.Row="2">
					<TextBlock Text="Voice:" VerticalAlignment="Center"/>
					<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding AutoObservationVoice, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
				</Grid>
			</Grid>
            <!--Wind Shear-->
			<Grid RowDefinitions="*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Wind Shear'}">
				<Grid Grid.Row="0" RowDefinitions="Auto,Auto,Auto" RowSpacing="16">
					<groupBox:GroupBoxControl Grid.Row="0" Header="Runway Specific" Theme="{StaticResource GroupBoxSection}">
						<Grid RowDefinitions="Auto,Auto" RowSpacing="10">
							<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
								<TextBlock Text="Text:" VerticalAlignment="Center"/>
								<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding RunwayWindShearText, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="120" Theme="{StaticResource DarkTextBox}"/>
							</Grid>
							<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
								<TextBlock Text="Voice:" VerticalAlignment="Center"/>
								<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding RunwayWindShearVoice, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="120" Theme="{StaticResource DarkTextBox}"/>
							</Grid>
						</Grid>
					</groupBox:GroupBoxControl>
					<groupBox:GroupBoxControl Grid.Row="1" Header="All Runways" Theme="{StaticResource GroupBoxSection}">
						<Grid RowDefinitions="Auto,Auto" RowSpacing="10">
							<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
								<TextBlock Text="Text:" VerticalAlignment="Center"/>
								<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding AllRunwayWindShearText, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="120" Theme="{StaticResource DarkTextBox}"/>
							</Grid>
							<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
								<TextBlock Text="Voice:" VerticalAlignment="Center"/>
								<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding AllRunwayWindShearVoice, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" MaxHeight="120" Theme="{StaticResource DarkTextBox}"/>
							</Grid>
						</Grid>
					</groupBox:GroupBoxControl>
					<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
						<Button
							Theme="{StaticResource DarkVariable}"
							ToolTip.Tip="This will be replaced by the runway identifier (e.g. 04R)."
							Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
							CommandParameter="{Binding $self.Content}">
							{Runway}
						</Button>
					</WrapPanel>
				</Grid>
			</Grid>
            <!--Trend Forecast-->
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Trend Forecast'}">
                <groupBox:GroupBoxControl Grid.Row="0" Header="Change Indicator" Theme="{StaticResource GroupBoxClassic}">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <Grid ColumnDefinitions="100,10,*,10,*">
                            <TextBlock Grid.Column="2">Text</TextBlock>
                            <TextBlock Grid.Column="4">Voice</TextBlock>
                        </Grid>
                        <Grid ColumnDefinitions="100,10,*,10,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center">NOSIG</TextBlock>
                            <TextBox FontFamily="{StaticResource Monospace}" Grid.Column="2" Text="{Binding NosigTextValue, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"></TextBox>
                            <TextBox FontFamily="{StaticResource Monospace}" Grid.Column="4" Text="{Binding NosigVoiceValue, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"></TextBox>
                        </Grid>
                        <Grid ColumnDefinitions="100,10,*,10,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center">BECMG</TextBlock>
                            <TextBox FontFamily="{StaticResource Monospace}" Grid.Column="2" Text="{Binding BecomingTextValue, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"></TextBox>
                            <TextBox FontFamily="{StaticResource Monospace}" Grid.Column="4" Text="{Binding BecomingVoiceValue, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"></TextBox>
                        </Grid>
                        <Grid ColumnDefinitions="100,10,*,10,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center">TEMPO</TextBlock>
                            <TextBox FontFamily="{StaticResource Monospace}" Grid.Column="2" Text="{Binding TemporaryTextValue, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"></TextBox>
                            <TextBox FontFamily="{StaticResource Monospace}" Grid.Column="4" Text="{Binding TemporaryVoiceValue, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"></TextBox>
                        </Grid>
                        <Grid ColumnDefinitions="100,10,*,10,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" ToolTip.Tip="Text to print and/or say when the TREND is not available in the METAR">Not Available</TextBlock>
                            <TextBox FontFamily="{StaticResource Monospace}" Grid.Column="2" Text="{Binding TrendNotAvailableTextValue, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"></TextBox>
                            <TextBox FontFamily="{StaticResource Monospace}" Grid.Column="4" Text="{Binding TrendNotAvailableVoiceValue, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"></TextBox>
                        </Grid>
                    </StackPanel>
                </groupBox:GroupBoxControl>
                <groupBox:GroupBoxControl Grid.Row="1" Header="Template" Theme="{StaticResource GroupBoxClassic}">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <Grid ColumnDefinitions="100,10,*,10,*">
                            <TextBlock Grid.Column="2">Text</TextBlock>
                            <TextBlock Grid.Column="4">Voice</TextBlock>
                        </Grid>
                        <Grid ColumnDefinitions="100,10,*,10,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center">Template</TextBlock>
                            <controls:TemplateVariableTextBox Grid.Column="2" Watermark="Text" Text="{Binding TrendTemplateText, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"/>
                            <controls:TemplateVariableTextBox Grid.Column="4" Watermark="Voice" Text="{Binding TrendTemplateVoice, DataType=vm:FormattingViewModel}" Theme="{StaticResource DarkTextBox}"/>
                        </Grid>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
                            <Button
                                Theme="{StaticResource DarkVariable}"
                                ToolTip.Tip="This will be replaced by the trend forecast (e.g. NOSIG)."
                                Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
                                CommandParameter="{Binding $self.Content}">
                                {Trend}
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </groupBox:GroupBoxControl>
            </Grid>
			<!--Transition Level-->
			<Grid RowDefinitions="*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Transition Level'}">
				<TabControl Grid.Row="0" Classes="Pages" SelectedIndex="{Binding SelectedFormattingPage, DataType=vm:FormattingViewModel, Mode=OneWay}">
					<TabItem Header="Template">
						<groupBox:GroupBoxControl Theme="{StaticResource GroupBoxSection}">
							<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
								<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
									<TextBlock Text="Text:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding TransitionLevelTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
									<TextBlock Text="Voice:" VerticalAlignment="Center"/>
									<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding TransitionLevelVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
								</Grid>
								<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The transition level altitude value (e.g. &quot;65&quot;). Add :### to zero-pad to a digit count (e.g. {trl:###} yields 065)."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{trl}
									</Button>
									<Button
										Theme="{StaticResource DarkVariable}"
										ToolTip.Tip="The transition level altitude in numeric word form (e.g. &quot;SIX FIVE&quot;)."
										Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
										CommandParameter="{Binding $self.Content}">
										{trl|text}
									</Button>
								</WrapPanel>
							</Grid>
						</groupBox:GroupBoxControl>
					</TabItem>
					<TabItem Header="Transition Levels">
						<Grid RowDefinitions="*,Auto" RowSpacing="10">
							<DataGrid Grid.Row="0" x:Name="TransitionLevels" GridLinesVisibility="All" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="1" BorderBrush="#646464" ItemsSource="{Binding TransitionLevels, DataType=vm:FormattingViewModel}">
								<Interaction.Behaviors>
									<behaviors:DataGridCellEndEditBehavior Command="{Binding CellEditEndingCommand, DataType=vm:FormattingViewModel}" DataGridName="TransitionLevels"/>
								</Interaction.Behaviors>
								<DataGrid.Styles>
									<Style Selector="DataGrid:focus DataGridCell:current /template/ Grid#FocusVisual">
										<Setter Property="IsVisible" Value="False" />
									</Style>
								</DataGrid.Styles>
								<DataGrid.Columns>
									<DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="QNH Low" Width="1*" Binding="{Binding Low, DataType=models:TransitionLevelMeta}" IsReadOnly="False"/>
									<DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="QNH High" Width="1*" Binding="{Binding High, DataType=models:TransitionLevelMeta}" IsReadOnly="False"/>
									<DataGridTextColumn FontFamily="{StaticResource Monospace}" Header="Transition Level" Width="1*" Binding="{Binding Altitude, DataType=models:TransitionLevelMeta}" IsReadOnly="False"/>
								</DataGrid.Columns>
							</DataGrid>
							<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
								<Button Theme="{StaticResource Dark}" Height="28" MinWidth="80" Command="{Binding DeleteTransitionLevelCommand, DataType=vm:FormattingViewModel}" CommandParameter="{Binding #TransitionLevels.SelectedItem}" IsEnabled="{Binding #TransitionLevels.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}">Delete</Button>
								<Button Theme="{StaticResource Dark}" Height="28" MinWidth="80" Command="{Binding AddTransitionLevelCommand, DataType=vm:FormattingViewModel}">Add New</Button>
							</StackPanel>
						</Grid>
					</TabItem>
				</TabControl>
			</Grid>
			<!--NOTAMs-->
			<Grid RowDefinitions="*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='NOTAMs'}">
				<groupBox:GroupBoxControl Grid.Row="0" Theme="{StaticResource GroupBoxSection}">
					<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
						<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
							<TextBlock Text="Text:" VerticalAlignment="Center"/>
							<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding NotamsTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
						</Grid>
						<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
							<TextBlock Text="Voice:" VerticalAlignment="Center"/>
							<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding NotamsVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
						</Grid>
						<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
							<Button
								Theme="{StaticResource DarkVariable}"
								ToolTip.Tip="The printed NOTAM text"
								Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
								CommandParameter="{Binding $self.Content}">
								{notams}
							</Button>
						</WrapPanel>
					</Grid>
				</groupBox:GroupBoxControl>
			</Grid>
			<!--Closing Statement-->
			<Grid RowDefinitions="Auto,*" RowSpacing="10" IsVisible="{Binding SelectedFormattingOption, DataType=vm:FormattingViewModel, Converter={StaticResource StringToBoolConverter}, ConverterParameter='Closing Statement'}">
				<CheckBox Grid.Row="0" IsChecked="{Binding ClosingStatementAutoIncludeClosingStatement, DataType=vm:FormattingViewModel}" Theme="{StaticResource CheckBox}" ToolTip.Tip="If enabled, the closing statement will be automatically appended to the end of the ATIS without requiring the [CLOSING] variable in the ATIS preset template. This is useful if you want to customize the position of the closing statement in the ATIS.">Automatically include closing statement at the end of the ATIS</CheckBox>
				<groupBox:GroupBoxControl Grid.Row="1" Theme="{StaticResource GroupBoxSection}">
					<Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
						<Grid RowDefinitions="Auto,Auto" Grid.Row="0">
							<TextBlock Text="Text:" VerticalAlignment="Center"/>
							<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding ClosingStatementTextTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
						</Grid>
						<Grid RowDefinitions="Auto,Auto" Grid.Row="1">
							<TextBlock Text="Voice:" VerticalAlignment="Center"/>
							<controls:TemplateVariableTextBox Grid.Row="1" Text="{Binding ClosingStatementVoiceTemplate, DataType=vm:FormattingViewModel}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80" MaxHeight="180" Theme="{StaticResource DarkTextBox}"/>
						</Grid>
						<WrapPanel Grid.Row="2" Orientation="Horizontal" ItemSpacing="10" LineSpacing="6">
							<Button
								Theme="{StaticResource DarkVariable}"
								ToolTip.Tip="The current ATIS letter (e.g. A)"
								Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
								CommandParameter="{Binding $self.Content}">
								{letter}
							</Button>
							<Button
								Theme="{StaticResource DarkVariable}"
								ToolTip.Tip="The current ATIS letter in word form (e.g. ALPHA)"
								Command="{Binding TemplateVariableClicked, DataType=vm:FormattingViewModel}"
								CommandParameter="{Binding $self.Content}">
								{letter|word}
							</Button>
						</WrapPanel>
					</Grid>
				</groupBox:GroupBoxControl>
			</Grid>
			</Grid>
		</Border>
	</Grid>
</UserControl>
