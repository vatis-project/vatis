<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Design.PreviewWith>
		<Border Padding="20" Background="#323232" Height="200" Width="500">
			<ComboBox Classes="Dark" HorizontalAlignment="Stretch">
				<ComboBoxItem>Item 1</ComboBoxItem>
				<ComboBoxItem>Item 2</ComboBoxItem>
			</ComboBox>
		</Border>
	</Design.PreviewWith>

	<Style Selector="ComboBox.Dark">

		<Setter Property="HorizontalAlignment" Value="Stretch"/>
		<Setter Property="MaxDropDownHeight" Value="186" />
		<Setter Property="Foreground" Value="#C0C0C0" />
		<Setter Property="Background" Value="#1E1E1E" />
		<Setter Property="BorderBrush" Value="#646464" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="CornerRadius" Value="3" />
		<Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
		<Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
		<Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
		<Setter Property="Padding" Value="5,3" />
		<Setter Property="MaxHeight" Value="28" />
		<Setter Property="PlaceholderForeground" Value="#C0C0C0" />

		<Setter Property="Template">
			<ControlTemplate>
				<Grid ColumnDefinitions="*,32">
					<Border x:Name="Background"
							Grid.Column="0"
							Grid.ColumnSpan="2"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}"
							CornerRadius="{TemplateBinding CornerRadius}"
							Background="{TemplateBinding Background}" />
					<ContentControl x:Name="ContentPresenter"
									Content="{TemplateBinding SelectionBoxItem}"
									ContentTemplate="{TemplateBinding ItemTemplate}"
									Grid.Column="0"
									Padding="{TemplateBinding Padding}"
									HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />

					<Border x:Name="GlyphSection"
							Grid.Column="1"
							IsHitTestVisible="False"
							Margin="3"
							Background="Transparent"
							CornerRadius="3" />
					<PathIcon x:Name="DropDownGlyph"
							  Grid.Column="1"
							  UseLayoutRounding="True"
							  IsHitTestVisible="False"
							  Height="12"
							  Width="12"
							  Margin="0,0,10,0"
							  HorizontalAlignment="Right"
							  VerticalAlignment="Center"
							  Foreground="#C0C0C0"
							  Data="M6.5,8.5l6,7l6-7H6.5z"/>
						<Popup
							Name="PART_Popup"
							Grid.Column="0"
							MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
							ClipToBounds="False"
							InheritsTransform="True"
							IsLightDismissEnabled="True"
							IsOpen="{TemplateBinding IsDropDownOpen,Mode=TwoWay}"
							HorizontalAlignment="Stretch"
							WindowManagerAddShadowHint="False">
							<Border x:Name="PopupShadowHost" Background="Transparent">
								<Border
									x:Name="PopupBorder"
									MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
									HorizontalAlignment="Stretch"
									Background="#141414"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									ClipToBounds="True"
									CornerRadius="{TemplateBinding CornerRadius}">
									<ScrollViewer
										MaxHeight="{TemplateBinding MaxDropDownHeight}"
										HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
										VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
										<ItemsPresenter
											Name="PART_ItemsPresenter"
											ItemsPanel="{TemplateBinding ItemsPanel}" />
									</ScrollViewer>
								</Border>
							</Border>
						</Popup>
				</Grid>
			</ControlTemplate>
		</Setter>

		<!--  PointerOver State  -->
		<Style Selector="^:pointerover /template/ Border#Background">
			<Setter Property="Background" Value="{TemplateBinding Background}" />
			<Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}" />
		</Style>

		<!--  Pressed State  -->
		<Style Selector="^:pressed /template/ Border#Background">
			<Setter Property="Background" Value="{TemplateBinding Background}" />
			<Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}" />
		</Style>

		<Style Selector="^:focus">
			<Style Selector="^ /template/ PathIcon#DropDownGlyph">
				<Setter Property="Foreground" Value="#ADBAC7" />
			</Style>
		</Style>

		<!-- Keyboard focus: a solid white square border, 3px with the inset shadow, like the other controls. -->
		<Style Selector="^:focus-visible /template/ Border#Background">
			<Setter Property="BorderBrush" Value="#FFFFFF" />
			<Setter Property="BoxShadow" Value="inset 0 0 0 2 #FFFFFF" />
			<Setter Property="CornerRadius" Value="0" />
		</Style>

		<Style Selector="^:dropdownopen">
			<Style Selector="^ /template/ Border#Background">
				<Setter Property="Background" Value="#141414"/>
			</Style>
		</Style>

		<Style Selector="^ ComboBoxItem">
			<Setter Property="Foreground" Value="Silver" />
			<Setter Property="FontSize" Value="{DynamicResource UiFontSize}"/>
			<Setter Property="Padding" Value="5,3"/>

			<!--  PointerOver state  -->
			<Style Selector="^:pointerover /template/ ContentPresenter">
				<Setter Property="Background" Value="#323232" />
				<Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
			</Style>

			<!--  Pressed state  -->
			<Style Selector="^:pressed /template/ ContentPresenter">
				<Setter Property="Background" Value="#323232" />
				<Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
			</Style>

			<!--  Selected state  -->
			<Style Selector="^:selected">
				<Style Selector="^ /template/ ContentPresenter">
					<Setter Property="Background" Value="#323232" />
					<Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
				</Style>
				<!--  Selected Pressed state  -->
				<Style Selector="^:pressed /template/ ContentPresenter">
					<Setter Property="Background" Value="#323232" />
					<Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
				</Style>
			</Style>
		</Style>
		<!-- Rows are inset from the edge of the list; the Large variant gets bigger rows to match a larger selected value. -->
		<Style Selector="^ ComboBoxItem">
			<Setter Property="Margin" Value="4,1"/>
			<Setter Property="Padding" Value="8,5"/>
		</Style>
		<Style Selector="^.Large ComboBoxItem">
			<Setter Property="Padding" Value="10,9"/>
			<Setter Property="FontSize" Value="15"/>
		</Style>
		<!-- The list is lighter than the page and has a brighter border so it stands out while open, and sits a few
		     pixels below the box. -->
		<Style Selector="^ /template/ Border#PopupBorder">
			<Setter Property="Background" Value="#2D2D2D"/>
			<Setter Property="BorderBrush" Value="#9A9A9A"/>
			<Setter Property="CornerRadius" Value="3"/>
			<Setter Property="Padding" Value="0,4"/>
			<!-- The popup window clips to its content, so the margin leaves room for the shadow to draw. Clipping the
			     border itself would cut it off too; the rows are inset so nothing overflows the rounded corners. -->
			<Setter Property="ClipToBounds" Value="False"/>
			<Setter Property="BoxShadow" Value="0 12 32 0 #B0000000"/>
		</Style>
		<Style Selector="^ /template/ Border#PopupShadowHost">
			<Setter Property="Padding" Value="32,12,32,44"/>
		</Style>
		<!-- The arrow sits in its own lighter rounded chip inside the border, and the box brightens on hover, so the closed
		     control reads as a drop-down rather than a flat text field. -->
		<Style Selector="^ /template/ Border#GlyphSection">
			<Setter Property="Background" Value="#4A4A4A"/>
		</Style>
		<Style Selector="^ /template/ Border#Background">
			<Setter Property="Background" Value="#1E1E1E"/>
		</Style>
		<Style Selector="^:pointerover:not(:focus-visible) /template/ Border#Background">
			<Setter Property="Background" Value="#282828"/>
			<Setter Property="BorderBrush" Value="#808080"/>
		</Style>
		<Style Selector="^:pointerover /template/ Border#GlyphSection">
			<Setter Property="Background" Value="#5E5E5E"/>
		</Style>
		<Style Selector="^ /template/ PathIcon#DropDownGlyph">
			<Setter Property="Foreground" Value="#FFFFFF"/>
		</Style>
		<Style Selector="^:dropdownopen /template/ Border#Background">
			<Setter Property="Background" Value="#1E1E1E"/>
			<Setter Property="BorderBrush" Value="#9A9A9A"/>
		</Style>
		<!-- Rows are rounded and inset from the edge of the list. -->
		<Style Selector="^ ComboBoxItem /template/ ContentPresenter">
			<Setter Property="CornerRadius" Value="3"/>
		</Style>
		<Style Selector="^ /template/ Popup#PART_Popup">
			<Setter Property="VerticalOffset" Value="-9"/>
		</Style>
		<Style Selector="^ ComboBoxItem:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="#454545"/>
		</Style>
		<Style Selector="^ ComboBoxItem:selected /template/ ContentPresenter">
			<Setter Property="Background" Value="#454545"/>
		</Style>
		<!-- Disabled: dim everything so it reads as unavailable, like the disabled buttons. -->
		<Style Selector="^ /template/ ContentControl#ContentPresenter">
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="^:disabled">
			<Setter Property="PlaceholderForeground" Value="#646464"/>
			<Style Selector="^ /template/ Border#Background">
				<Setter Property="Background" Value="#262626"/>
				<Setter Property="BorderBrush" Value="#3C3C3C"/>
			</Style>
			<Style Selector="^ /template/ ContentControl#ContentPresenter">
				<Setter Property="Foreground" Value="#646464"/>
			</Style>
			<Style Selector="^ /template/ Border#GlyphSection">
				<Setter Property="Background" Value="#303030"/>
			</Style>
			<Style Selector="^ /template/ PathIcon#DropDownGlyph">
				<Setter Property="Foreground" Value="#646464"/>
			</Style>
		</Style>
	</Style>
</Styles>