<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Vatsim.Vatis.Ui.ViewModels"
        xmlns:behaviors="using:Vatsim.Vatis.Ui.Behaviors"
        xmlns:editor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        mc:Ignorable="d"
        x:Class="Vatsim.Vatis.Ui.Dialogs.StaticDefinitionEditorDialog"
        Title="StaticDefinitionEditorDialog"
        x:Name="Window"
        Width="700" d:DesignHeight="325"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
	<Window.Styles>
		<Style Selector="DataValidationErrors">
			<Setter Property="Template">
				<ControlTemplate>
					<DockPanel LastChildFill="True">
						<ContentControl DockPanel.Dock="Bottom"
										ContentTemplate="{TemplateBinding ErrorTemplate}"
										DataContext="{TemplateBinding Owner}"
										Content="{Binding (DataValidationErrors.Errors)}"
										IsVisible="{Binding (DataValidationErrors.HasErrors)}"/>
						<ContentPresenter Name="PART_ContentPresenter"
										  Background="{TemplateBinding Background}"
										  BorderBrush="{TemplateBinding BorderBrush}"
										  BorderThickness="{TemplateBinding BorderThickness}"
										  CornerRadius="{TemplateBinding CornerRadius}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  Content="{TemplateBinding Content}"
										  Padding="{TemplateBinding Padding}"/>
					</DockPanel>
				</ControlTemplate>
			</Setter>
			<Setter Property="ErrorTemplate">
				<DataTemplate x:DataType="{x:Type x:Object}">
					<ItemsControl ItemsSource="{Binding}" Margin="0 5 0 0" Foreground="#FCBA03">
						<ItemsControl.Styles>
							<Style Selector="TextBlock">
								<Setter Property="TextWrapping" Value="Wrap" />
								<Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
							</Style>
						</ItemsControl.Styles>
					</ItemsControl>
				</DataTemplate>
			</Setter>
		</Style>
	</Window.Styles>
	<Border VerticalAlignment="Center" BorderBrush="#646464" BorderThickness="1" Background="#323232" CornerRadius="5">
		<StackPanel>
			<Border CornerRadius="5,5,0,0" Background="#282828" Height="40" PointerPressed="OnPointerPressed">
				<Grid ColumnDefinitions="1*,1*">
					<TextBlock Text="{Binding Title, DataType=vm:StaticDefinitionEditorDialogViewModel, FallbackValue='Definition Editor'}" Padding="5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#F0F0F0" FontWeight="Medium" FontSize="{DynamicResource UiFontSize}" Grid.Column="0" />
					<Button Grid.Column="1" Theme="{StaticResource CloseButton}" HorizontalAlignment="Right" Margin="0,0,10,0" Command="{Binding CancelButtonCommand, DataType=vm:StaticDefinitionEditorDialogViewModel}" CommandParameter="{Binding ElementName=Window}"/>
				</Grid>
			</Border>
			<Grid RowDefinitions="Auto,10,Auto" Margin="20">
				<StackPanel Grid.Row="0" Orientation="Vertical" Spacing="5">
					<editor:TextEditor Document="{Binding TextDocument, DataType=vm:StaticDefinitionEditorDialogViewModel}" WordWrap="True" Height="180" FontFamily="{StaticResource Monospace}" Padding="6,4">
						<Interaction.Behaviors>
							<behaviors:TextEditorUpperCaseBehavior/>
							<behaviors:TextEditorCompletionBehavior CompletionData="{Binding ContractionCompletionData, DataType=vm:StaticDefinitionEditorDialogViewModel}"/>
							<behaviors:TextEditorSpokenTextBehavior/>
						</Interaction.Behaviors>
					</editor:TextEditor>
					<Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto">
						<Grid.Styles>
							<Style Selector="ComboBox.field, TextBox.field, Button.field">
								<Setter Property="Height" Value="28" />
								<Setter Property="VerticalAlignment" Value="Center" />
							</Style>
							<Style Selector="TextBox.field">
								<Setter Property="VerticalContentAlignment" Value="Center" />
								<Setter Property="Padding" Value="6,0" />
							</Style>
							<Style Selector="TextBlock.label">
								<Setter Property="VerticalAlignment" Value="Center" />
								<Setter Property="Margin" Value="0,0,8,0" />
							</Style>
						</Grid.Styles>
						<TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="Separator after:" ToolTip.Tip="Optional. Text placed after this entry before the next one, used exactly as typed (including spaces). Leave blank to use the list's default separator. Ignored for the last entry." />
						<TextBox Classes="field" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" FontFamily="{StaticResource Monospace}" Watermark="Default separator" Theme="{StaticResource DarkTextBox}" Text="{Binding SeparatorAfter, DataType=vm:StaticDefinitionEditorDialogViewModel}" />

						<TextBlock Classes="label" Grid.Row="1" Grid.Column="0" Text="Include:" ToolTip.Tip="Optionally include this entry only while specific controllers are online (or offline), based on the VATSIM data feed." />
						<Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="200,*" Margin="0,0,0,5">
							<ComboBox Classes="Dark field" Grid.Column="0" HorizontalAlignment="Stretch" SelectedIndex="{Binding StationConditionIndex, DataType=vm:StaticDefinitionEditorDialogViewModel}">
								<ComboBoxItem>Always</ComboBoxItem>
								<ComboBoxItem>When online</ComboBoxItem>
								<ComboBoxItem>When offline</ComboBoxItem>
							</ComboBox>
							<TextBox Classes="field" Grid.Column="1" Margin="5,0,0,0" FontFamily="{StaticResource Monospace}" Watermark="EPWA_APP, EPWW_*_CTR" Theme="{StaticResource DarkTextBox}" IsVisible="{Binding HasStationCondition, DataType=vm:StaticDefinitionEditorDialogViewModel}" Text="{Binding StationCallsigns, DataType=vm:StaticDefinitionEditorDialogViewModel}" ToolTip.Tip="Callsigns separated by commas or spaces. Use * as a wildcard, e.g. EPWW_*_CTR." />
						</Grid>

						<TextBlock Classes="label" Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,6,8,0" Text="Weather:" ToolTip.Tip="Optionally include this entry only when the METAR meets this condition. Combine comparisons with AND, OR and NOT, and group them with parentheses. AND is evaluated before OR." />
						<editor:TextEditor Grid.Row="2" Grid.Column="1" Name="WeatherEditor" WordWrap="True" Height="56" FontFamily="{StaticResource Monospace}" Padding="6,4" ToolTip.Tip="Fields: ceiling, cloudbase, rvr, visibility, windspeed, gust, winddir, temperature, dewpoint, qnh, depth, weather, cloudtype, windshear, cavok. Compare with &lt; &lt;= &gt; &gt;= = and an optional unit (200ft, 550m, 15kt). Use INCLUDES or EXCLUDES for weather and cloudtype, e.g. weather INCLUDES TS. Use NOT with windshear and cavok.">
							<Interaction.Behaviors>
								<behaviors:DocumentTextBindingBehavior Text="{Binding WeatherCondition, DataType=vm:StaticDefinitionEditorDialogViewModel, Mode=TwoWay}"/>
								<behaviors:TextEditorWeatherCompletionBehavior/>
							</Interaction.Behaviors>
						</editor:TextEditor>
						<StackPanel Grid.Row="3" Grid.Column="1" Margin="0,5,0,0" Spacing="3">
							<TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12" Text="Example: ceiling &lt; 200ft AND (rvr &lt; 550m OR visibility &lt; 100m). Suggestions appear as you type; press Ctrl+Space to show them." />
							<TextBlock TextWrapping="Wrap" Foreground="#FCBA03" Text="{Binding WeatherConditionError, DataType=vm:StaticDefinitionEditorDialogViewModel}">
								<TextBlock.IsVisible>
									<!-- Not while the box has focus: an unfinished condition is not an error yet. -->
									<MultiBinding Converter="{x:Static BoolConverters.And}" x:DataType="vm:StaticDefinitionEditorDialogViewModel">
										<Binding Path="HasWeatherConditionError" x:DataType="vm:StaticDefinitionEditorDialogViewModel" />
										<Binding Path="!#WeatherEditor.IsKeyboardFocusWithin" />
									</MultiBinding>
								</TextBlock.IsVisible>
							</TextBlock>
						</StackPanel>
					</Grid>
					<TextBox FontFamily="{StaticResource Monospace}" Name="DataValidation" Theme="{StaticResource Hidden}" Text="{Binding DataValidation, DataType=vm:StaticDefinitionEditorDialogViewModel}"/>
				</StackPanel>
				<StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5">
					<Button Width="80" Theme="{StaticResource Dark}" Command="{Binding SaveButtonCommand, DataType=vm:StaticDefinitionEditorDialogViewModel}" CommandParameter="{Binding ElementName=Window}">Save</Button>
					<Button Width="80" Theme="{StaticResource Dark}" Command="{Binding CancelButtonCommand, DataType=vm:StaticDefinitionEditorDialogViewModel}" CommandParameter="{Binding ElementName=Window}">Cancel</Button>
				</StackPanel>
			</Grid>
		</StackPanel>
	</Border>
</Window>
