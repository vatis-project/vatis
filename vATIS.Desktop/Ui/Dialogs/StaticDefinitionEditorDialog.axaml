<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Vatsim.Vatis.Ui.ViewModels"
        xmlns:behaviors="using:Vatsim.Vatis.Ui.Behaviors"
        xmlns:editor="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        mc:Ignorable="d"
        x:Class="Vatsim.Vatis.Ui.Dialogs.StaticDefinitionEditorDialog"
        Title="StaticDefinitionEditorDialog"
        x:Name="Window"
        Width="700" d:DesignHeight="325"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
	<Window.Styles>
		<Style Selector="DataValidationErrors">
			<Setter Property="Template">
				<ControlTemplate>
					<DockPanel LastChildFill="True">
						<ContentControl DockPanel.Dock="Bottom"
										ContentTemplate="{TemplateBinding ErrorTemplate}"
										DataContext="{TemplateBinding Owner}"
										Content="{Binding (DataValidationErrors.Errors)}"
										IsVisible="{Binding (DataValidationErrors.HasErrors)}"/>
						<ContentPresenter Name="PART_ContentPresenter"
										  Background="{TemplateBinding Background}"
										  BorderBrush="{TemplateBinding BorderBrush}"
										  BorderThickness="{TemplateBinding BorderThickness}"
										  CornerRadius="{TemplateBinding CornerRadius}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  Content="{TemplateBinding Content}"
										  Padding="{TemplateBinding Padding}"/>
					</DockPanel>
				</ControlTemplate>
			</Setter>
			<Setter Property="ErrorTemplate">
				<DataTemplate x:DataType="{x:Type x:Object}">
					<ItemsControl ItemsSource="{Binding}" Margin="0 5 0 0" Foreground="#FCBA03">
						<ItemsControl.Styles>
							<Style Selector="TextBlock">
								<Setter Property="TextWrapping" Value="Wrap" />
								<Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
							</Style>
						</ItemsControl.Styles>
					</ItemsControl>
				</DataTemplate>
			</Setter>
		</Style>
	</Window.Styles>
	<Border VerticalAlignment="Center" BorderBrush="#646464" BorderThickness="1" Background="#323232" CornerRadius="5">
		<StackPanel>
			<Border CornerRadius="5,5,0,0" Background="#282828" Height="40" PointerPressed="OnPointerPressed">
				<Grid ColumnDefinitions="1*,1*">
					<TextBlock Text="{Binding Title, DataType=vm:StaticDefinitionEditorDialogViewModel, FallbackValue='Definition Editor'}" Padding="5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#F0F0F0" FontWeight="Medium" FontSize="{DynamicResource UiFontSize}" Grid.Column="0" />
					<Button Grid.Column="1" Theme="{StaticResource CloseButton}" HorizontalAlignment="Right" Margin="0,0,10,0" Command="{Binding CancelButtonCommand, DataType=vm:StaticDefinitionEditorDialogViewModel}" CommandParameter="{Binding ElementName=Window}"/>
				</Grid>
			</Border>
			<Grid RowDefinitions="Auto,10,Auto" Margin="20">
				<StackPanel Grid.Row="0" Orientation="Vertical" Spacing="5">
					<editor:TextEditor Document="{Binding TextDocument, DataType=vm:StaticDefinitionEditorDialogViewModel}" WordWrap="True" Height="180" FontFamily="{StaticResource Monospace}" Padding="6,4">
						<Interaction.Behaviors>
							<behaviors:TextEditorUpperCaseBehavior/>
							<behaviors:TextEditorCompletionBehavior CompletionData="{Binding ContractionCompletionData, DataType=vm:StaticDefinitionEditorDialogViewModel}"/>
							<behaviors:TextEditorSpokenTextBehavior/>
						</Interaction.Behaviors>
					</editor:TextEditor>
					<Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto">
						<Grid.Styles>
							<Style Selector="ComboBox.field, TextBox.field, Button.field">
								<Setter Property="Height" Value="28" />
								<Setter Property="VerticalAlignment" Value="Center" />
							</Style>
							<Style Selector="TextBox.field">
								<Setter Property="VerticalContentAlignment" Value="Center" />
								<Setter Property="Padding" Value="6,0" />
							</Style>
							<Style Selector="Button.info">
								<Setter Property="Width" Value="18" />
								<Setter Property="Height" Value="18" />
								<Setter Property="MinWidth" Value="0" />
								<Setter Property="MinHeight" Value="0" />
								<Setter Property="Padding" Value="0" />
								<Setter Property="Cursor" Value="Hand" />
								<Setter Property="VerticalAlignment" Value="Center" />
							</Style>
							<Style Selector="Button.info /template/ ContentPresenter#PART_ContentPresenter">
								<Setter Property="Background" Value="Transparent" />
								<Setter Property="BorderBrush" Value="#8C8C8C" />
								<Setter Property="BorderThickness" Value="1.5" />
								<Setter Property="CornerRadius" Value="9" />
							</Style>
							<Style Selector="Button.info:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.info:pressed /template/ ContentPresenter#PART_ContentPresenter">
								<Setter Property="Background" Value="Transparent" />
								<Setter Property="BorderBrush" Value="#FFFFFF" />
							</Style>
							<Style Selector="Button.info > TextBlock">
								<Setter Property="Foreground" Value="#8C8C8C" />
								<Setter Property="FontSize" Value="12" />
								<Setter Property="FontWeight" Value="Bold" />
								<Setter Property="HorizontalAlignment" Value="Center" />
								<Setter Property="VerticalAlignment" Value="Center" />
							</Style>
							<Style Selector="Button.info:pointerover > TextBlock, Button.info:pressed > TextBlock">
								<Setter Property="Foreground" Value="#FFFFFF" />
							</Style>
							<Style Selector="TextBlock.label">
								<Setter Property="VerticalAlignment" Value="Center" />
								<Setter Property="Margin" Value="0,0,8,0" />
							</Style>
						</Grid.Styles>
						<TextBlock Classes="label" Grid.Row="0" Grid.Column="0" Text="Separator after:" ToolTip.Tip="Optional. Text placed after this entry before the next one, used exactly as typed (including spaces). Use \n for a line break. Leave blank to use the list's default separator. Ignored for the last entry." />
						<TextBox Classes="field" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5" FontFamily="{StaticResource Monospace}" Watermark="Default separator" Theme="{StaticResource DarkTextBox}" Text="{Binding SeparatorAfter, DataType=vm:StaticDefinitionEditorDialogViewModel}" />

						<StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
							<TextBlock Classes="label" Text="Condition:" />
							<Button Classes="info">
								<TextBlock Text="i" />
								<Button.Flyout>
									<Flyout Placement="BottomEdgeAlignedLeft">
										<StackPanel MaxWidth="360" Spacing="8">
											<TextBlock TextWrapping="Wrap" Text="Include this message only while the condition is met. Mix controllers online, the time in Zulu, the METAR and the preset's runways with AND, OR, NOT and parentheses. Leave blank to always include."/>
											<StackPanel>
												<TextBlock FontFamily="{StaticResource Monospace}" TextWrapping="Wrap" Text="LAX_TWR"/>
												<TextBlock Margin="12,1,0,0" Opacity="0.7" TextWrapping="Wrap" Text="when LAX Tower is online"/>
											</StackPanel>
											<StackPanel>
												<TextBlock FontFamily="{StaticResource Monospace}" TextWrapping="Wrap" Text="NOT SCT_APP"/>
												<TextBlock Margin="12,1,0,0" Opacity="0.7" TextWrapping="Wrap" Text="when SoCal Approach is offline"/>
											</StackPanel>
											<StackPanel>
												<TextBlock FontFamily="{StaticResource Monospace}" TextWrapping="Wrap" Text="2200z-0600z"/>
												<TextBlock Margin="12,1,0,0" Opacity="0.7" TextWrapping="Wrap" Text="between 2200Z and 0600Z, which can cross midnight"/>
											</StackPanel>
											<StackPanel>
												<TextBlock FontFamily="{StaticResource Monospace}" TextWrapping="Wrap" Text="ceiling &lt; 200ft"/>
												<TextBlock Margin="12,1,0,0" Opacity="0.7" TextWrapping="Wrap" Text="when the ceiling is below 200 ft"/>
											</StackPanel>
											<StackPanel>
												<TextBlock FontFamily="{StaticResource Monospace}" TextWrapping="Wrap" Text="weather INCLUDES TS"/>
												<TextBlock Margin="12,1,0,0" Opacity="0.7" TextWrapping="Wrap" Text="when a thunderstorm is reported"/>
											</StackPanel>
											<StackPanel>
												<TextBlock FontFamily="{StaticResource Monospace}" TextWrapping="Wrap" Text="dep:07L"/>
												<TextBlock Margin="12,1,0,0" Opacity="0.7" TextWrapping="Wrap" Text="when 07L is one of the preset's departure runways"/>
											</StackPanel>
											<StackPanel>
												<TextBlock FontFamily="{StaticResource Monospace}" TextWrapping="Wrap" Text="arr:25*"/>
												<TextBlock Margin="12,1,0,0" Opacity="0.7" TextWrapping="Wrap" Text="when an arrival runway is 25L, 25R and so on"/>
											</StackPanel>
											<StackPanel>
												<TextBlock FontFamily="{StaticResource Monospace}" TextWrapping="Wrap" Text="EPKK_E_APP AND dep:07"/>
												<TextBlock Margin="12,1,0,0" Opacity="0.7" TextWrapping="Wrap" Text="when E_APP is online and 07 is a departure runway"/>
											</StackPanel>
											<StackPanel>
												<TextBlock FontFamily="{StaticResource Monospace}" TextWrapping="Wrap" Text="LAX_TWR AND (ceiling &lt; 200ft OR rvr &lt; 550m)"/>
												<TextBlock Margin="12,1,0,0" Opacity="0.7" TextWrapping="Wrap" Text="when Tower is online and the weather is poor"/>
											</StackPanel>
											<TextBlock TextWrapping="Wrap">
												<Run Text="A plain word is a controller callsign, and "/>
												<Run FontFamily="{StaticResource Monospace}" Text="*"/>
												<Run Text=" matches any characters. Runways need "/>
												<Run FontFamily="{StaticResource Monospace}" Text="dep:"/>
												<Run Text=", "/>
												<Run FontFamily="{StaticResource Monospace}" Text="arr:"/>
												<Run Text=" or "/>
												<Run FontFamily="{StaticResource Monospace}" Text="rwy:"/>
												<Run Text=" (either). Weather terms are never met when there is no METAR."/>
											</TextBlock>
										</StackPanel>
									</Flyout>
								</Button.Flyout>
							</Button>
						</StackPanel>
						<StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5,0,0" Spacing="3">
							<editor:TextEditor Name="ConditionEditor" WordWrap="True" MinHeight="64" FontFamily="{StaticResource Monospace}" Padding="6,4">
								<Interaction.Behaviors>
									<behaviors:DocumentTextBindingBehavior Text="{Binding Condition, DataType=vm:StaticDefinitionEditorDialogViewModel, Mode=TwoWay}"/>
									<behaviors:TextEditorConditionCompletionBehavior Runways="{Binding Runways, DataType=vm:StaticDefinitionEditorDialogViewModel}"/>
								</Interaction.Behaviors>
							</editor:TextEditor>
							<TextBlock TextWrapping="Wrap" Opacity="0.6" FontSize="12" Text="Example: EPKK_E_APP AND dep:07 AND NOT ceiling &lt; 200ft. Suggestions appear as you type." />
							<TextBlock TextWrapping="Wrap" Foreground="#FCBA03" Text="{Binding ConditionError, DataType=vm:StaticDefinitionEditorDialogViewModel}">
								<TextBlock.IsVisible>
									<!-- Not while the box has focus: an unfinished condition is not an error yet. -->
									<MultiBinding Converter="{x:Static BoolConverters.And}" x:DataType="vm:StaticDefinitionEditorDialogViewModel">
										<Binding Path="HasConditionError" x:DataType="vm:StaticDefinitionEditorDialogViewModel" />
										<Binding Path="!#ConditionEditor.IsKeyboardFocusWithin" />
									</MultiBinding>
								</TextBlock.IsVisible>
							</TextBlock>
						</StackPanel>
					</Grid>
					<TextBox FontFamily="{StaticResource Monospace}" Name="DataValidation" Theme="{StaticResource Hidden}" Text="{Binding DataValidation, DataType=vm:StaticDefinitionEditorDialogViewModel}"/>
				</StackPanel>
				<StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="5">
					<Button Width="80" Theme="{StaticResource Dark}" Command="{Binding SaveButtonCommand, DataType=vm:StaticDefinitionEditorDialogViewModel}" CommandParameter="{Binding ElementName=Window}">Save</Button>
					<Button Width="80" Theme="{StaticResource Dark}" Command="{Binding CancelButtonCommand, DataType=vm:StaticDefinitionEditorDialogViewModel}" CommandParameter="{Binding ElementName=Window}">Cancel</Button>
				</StackPanel>
			</Grid>
		</StackPanel>
	</Border>
</Window>
