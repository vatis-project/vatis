<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Vatsim.Vatis.Ui.ViewModels"
        xmlns:models="using:Vatsim.Vatis.Ui.Models"
        xmlns:profiles="using:Vatsim.Vatis.Profiles.Models"
        xmlns:behaviors="using:Vatsim.Vatis.Ui.Behaviors"
        xmlns:conv="using:Vatsim.Vatis.Ui.Converters"
        mc:Ignorable="d"
        x:Class="Vatsim.Vatis.Ui.Dialogs.StaticAirportConditionsDialog"
        Title="AirportConditionsDialog"
        x:Name="Window"
        Width="570" Height="335"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
	<Window.Resources>
		<conv:BoolToBrushColorConverter x:Key="BoolToBrushColorConverter" TrueColor="Black" FalseColor="#646464"/>
	</Window.Resources>
	<Window.Styles>
		<Style Selector="MenuFlyoutPresenter.spacer">
			<Setter Property="MinWidth" Value="86" />
			<Setter Property="MaxWidth" Value="100" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="#1E1E1E" />
			<Setter Property="BorderBrush" Value="#646464" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="4" />
		</Style>
		<Style Selector="DataValidationErrors">
			<Setter Property="Template">
				<ControlTemplate>
					<DockPanel LastChildFill="True">
						<ContentControl DockPanel.Dock="Bottom"
										ContentTemplate="{TemplateBinding ErrorTemplate}"
										DataContext="{TemplateBinding Owner}"
										Content="{Binding (DataValidationErrors.Errors)}"
										IsVisible="{Binding (DataValidationErrors.HasErrors)}"/>
						<ContentPresenter Name="PART_ContentPresenter"
										  Background="{TemplateBinding Background}"
										  BorderBrush="{TemplateBinding BorderBrush}"
										  BorderThickness="{TemplateBinding BorderThickness}"
										  CornerRadius="{TemplateBinding CornerRadius}"
										  ContentTemplate="{TemplateBinding ContentTemplate}"
										  Content="{TemplateBinding Content}"
										  Padding="{TemplateBinding Padding}"/>
					</DockPanel>
				</ControlTemplate>
			</Setter>
			<Setter Property="ErrorTemplate">
				<DataTemplate x:DataType="{x:Type x:Object}">
					<ItemsControl ItemsSource="{Binding}" Margin="0 5 0 0" Foreground="#FCBA03">
						<ItemsControl.Styles>
							<Style Selector="TextBlock">
								<Setter Property="TextWrapping" Value="Wrap" />
							</Style>
						</ItemsControl.Styles>
					</ItemsControl>
				</DataTemplate>
			</Setter>
		</Style>
	</Window.Styles>
	<Border VerticalAlignment="Center" BorderBrush="{Binding ShowOverlay, DataType=vm:StaticAirportConditionsDialogViewModel, Converter={StaticResource BoolToBrushColorConverter}, FallbackValue=#646464}" BorderThickness="1" Background="#323232" CornerRadius="5">
		<Grid>
			<Grid x:Name="Overlay" ZIndex="100" IsVisible="{Binding ShowOverlay, DataType=vm:StaticAirportConditionsDialogViewModel, FallbackValue=False}">
				<Border Background="#000000" Opacity="0.80"/>
			</Grid>
			<StackPanel Orientation="Vertical">
				<Border CornerRadius="5,5,0,0" Background="#282828" Height="40" PointerPressed="OnPointerPressed">
					<Grid ColumnDefinitions="1*,1*">
						<TextBlock Text="Airport Conditions" Padding="5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#F0F0F0" FontWeight="Medium" FontSize="{DynamicResource UiFontSize}" Grid.Column="0" />
						<Button Grid.Column="1" Theme="{StaticResource CloseButton}" HorizontalAlignment="Right" Margin="0,0,10,0" Command="{Binding CloseWindowCommand, DataType=vm:StaticAirportConditionsDialogViewModel}" CommandParameter="{Binding ElementName=Window}"/>
					</Grid>
				</Border>
				<StackPanel Margin="20">
					<StackPanel Orientation="Vertical">
						<Grid ColumnDefinitions="1*,10,100">
							<Border Grid.Column="0" VerticalAlignment="Top" BorderBrush="#646464" BorderThickness="1" CornerRadius="5" Height="40" IsVisible="{Binding !HasDefinitions, DataType=vm:StaticAirportConditionsDialogViewModel, FallbackValue=True}">
								<TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">No Airport Conditions Defined</TextBlock>
							</Border>
							<Border Grid.Column="0" VerticalAlignment="Top" CornerRadius="5" BorderBrush="#646464" BorderThickness="1" Padding="10" MinHeight="40" MaxHeight="200" IsVisible="{Binding HasDefinitions, DataType=vm:StaticAirportConditionsDialogViewModel, FallbackValue=False}">
								<DataGrid Classes="graySelection" ItemsSource="{Binding Source.Items, DataType=vm:StaticAirportConditionsDialogViewModel}" SelectedIndex="{Binding Source.SelectedIndex, DataType=vm:StaticAirportConditionsDialogViewModel, Mode=TwoWay}" SelectionMode="Extended" HeadersVisibility="None" GridLinesVisibility="None" IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="0">
									<Interaction.Behaviors>
										<behaviors:DataGridKeyboardBehavior PassSelectedItem="False"
																			EditCommand="{Binding EditDefinitionCommand, DataType=vm:StaticAirportConditionsDialogViewModel}"
																			MoveUpCommand="{Binding MoveDefinitionUpCommand, DataType=vm:StaticAirportConditionsDialogViewModel}"
																			MoveDownCommand="{Binding MoveDefinitionDownCommand, DataType=vm:StaticAirportConditionsDialogViewModel}"/>
										<behaviors:DataGridSelectedItemsBehavior SelectedItems="{Binding Source.SelectedItems, DataType=vm:StaticAirportConditionsDialogViewModel}"/>
										<behaviors:ScrollToSelectedItemBehavior/>
									</Interaction.Behaviors>
									<DataGrid.Styles>
										<Style Selector="DataGridCell">
											<Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
										</Style>
										<!-- Only show the focus box after the list is tabbed into, not when it is clicked. -->
										<Style Selector="DataGrid:not(:keynav) DataGridCell:current /template/ Grid#FocusVisual">
											<Setter Property="IsVisible" Value="False"/>
										</Style>
										<!-- The headers are hidden, so the line under them is too. -->
										<Style Selector="DataGrid /template/ Rectangle#PART_ColumnHeadersAndRowsSeparator">
											<Setter Property="IsVisible" Value="False"/>
										</Style>
									</DataGrid.Styles>
									<DataGrid.Columns>
										<DataGridTemplateColumn Width="Auto">
											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate DataType="profiles:StaticDefinition">
													<!-- Not a tab stop of its own: the list is, and Space toggles the selected row. -->
													<CheckBox Theme="{StaticResource CheckBox}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="4,0" Focusable="False"/>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>
										<DataGridTemplateColumn Width="*">
											<DataGridTemplateColumn.CellTemplate>
												<DataTemplate DataType="profiles:StaticDefinition">
													<!-- Rows are reused for other items, so the cell is rebuilt whenever its item changes. -->
													<ContentControl Content="{Binding}" ContentTemplate="{x:Static models:StaticDefinitionCellTemplate.Instance}"/>
												</DataTemplate>
											</DataGridTemplateColumn.CellTemplate>
										</DataGridTemplateColumn>
									</DataGrid.Columns>
								</DataGrid>
							</Border>
							<!--Action Buttons-->
							<StackPanel Grid.Column="2" Orientation="Vertical" Spacing="5" VerticalAlignment="Top">
								<Button Theme="{StaticResource Dark}" Command="{Binding NewDefinitionCommand, DataType=vm:StaticAirportConditionsDialogViewModel}">New</Button>
								<Button Theme="{StaticResource Dark}" Content="Spacer..." ToolTip.Tip="Adds an empty line or a line break between the definitions around it">
									<Button.Flyout>
										<MenuFlyout Placement="BottomEdgeAlignedLeft" VerticalOffset="3" FlyoutPresenterClasses="spacer">
											<MenuItem Header="Blank Line" Command="{Binding NewBlankLineCommand, DataType=vm:StaticAirportConditionsDialogViewModel}" />
											<MenuItem Header="New Line" Command="{Binding NewLineCommand, DataType=vm:StaticAirportConditionsDialogViewModel}" />
										</MenuFlyout>
									</Button.Flyout>
								</Button>
								<Button Theme="{StaticResource Dark}" Command="{Binding EditDefinitionCommand, DataType=vm:StaticAirportConditionsDialogViewModel}">Edit</Button>
								<Button Theme="{StaticResource Dark}" Command="{Binding DeleteDefinitionCommand, DataType=vm:StaticAirportConditionsDialogViewModel}">Delete</Button>
								<StackPanel Orientation="Vertical" Spacing="5" Margin="0,10,0,0" IsVisible="{Binding HasDefinitions, DataType=vm:StaticAirportConditionsDialogViewModel, FallbackValue=False}">
									<Button Theme="{StaticResource Dark}" Command="{Binding MoveDefinitionUpCommand, DataType=vm:StaticAirportConditionsDialogViewModel}">Up</Button>
									<Button Theme="{StaticResource Dark}" Command="{Binding MoveDefinitionDownCommand, DataType=vm:StaticAirportConditionsDialogViewModel}">Down</Button>
								</StackPanel>
							</StackPanel>
						</Grid>
					</StackPanel>
					<Grid ColumnDefinitions="1*,Auto" Margin="0,15,0,0">
						<CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Theme="{StaticResource CheckBox}" IsChecked="{Binding IncludeBeforeFreeText, DataType=vm:StaticAirportConditionsDialogViewModel, FallbackValue=False}" ToolTip.Tip="When enabled, the selected definitions will be included before the free-form airport conditions text in the generated ATIS.">Include before free-form Airport Conditions.</CheckBox>
						<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
							<TextBlock VerticalAlignment="Center" Text="Default separator:" ToolTip.Tip="Applies to every entry in this list unless an entry sets its own. Text placed between each selected airport conditions definition, used exactly as typed (including spaces). Use \n for a line break. Default is a period followed by a space. To override it for one entry, edit that entry and set its 'Separator after'." />
							<TextBox Width="80" Height="30" MinHeight="30" FontFamily="{StaticResource Monospace}" Theme="{StaticResource DarkTextBox}" Text="{Binding Separator, DataType=vm:StaticAirportConditionsDialogViewModel}" />
						</StackPanel>
					</Grid>
				</StackPanel>
			</StackPanel>
		</Grid>
	</Border>
</Window>
