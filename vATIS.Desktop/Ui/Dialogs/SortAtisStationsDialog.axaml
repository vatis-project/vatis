<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Vatsim.Vatis.Ui.ViewModels"
        xmlns:models="using:Vatsim.Vatis.Profiles.Models"
        xmlns:behaviors="clr-namespace:Vatsim.Vatis.Ui.Behaviors"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Vatsim.Vatis.Ui.Dialogs.SortAtisStationsDialog"
        Title="SortAtisStationsDialog"
        x:Name="Window"
        Width="570" MaxHeight="325"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
	<Border BorderBrush="#646464" BorderThickness="1" Background="#323232" CornerRadius="5">
			<StackPanel Orientation="Vertical">
				<Border CornerRadius="5,5,0,0" Background="#282828" Height="40" PointerPressed="OnPointerPressed">
					<Grid ColumnDefinitions="1*,1*">
						<TextBlock Text="Sort ATIS Stations" Padding="5" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#F0F0F0" FontWeight="Medium" FontSize="{DynamicResource UiFontSize}" Grid.Column="0" />
						<Button Grid.Column="1" Theme="{StaticResource CloseButton}" HorizontalAlignment="Right" Margin="0,0,10,0" Command="{Binding CloseWindowCommand, DataType=vm:SortAtisStationsDialogViewModel}" CommandParameter="{Binding ElementName=Window}"/>
					</Grid>
				</Border>
				<Grid ColumnDefinitions="1*,10,100" Margin="20">
					<Border Grid.Column="0" CornerRadius="5" BorderBrush="#646464" BorderThickness="1" Padding="10" MaxHeight="200">
						<DataGrid x:Name="StationsGrid" ItemsSource="{Binding Source.Items, DataType=vm:SortAtisStationsDialogViewModel}" SelectedIndex="{Binding Source.SelectedIndex, DataType=vm:SortAtisStationsDialogViewModel, Mode=TwoWay}" SelectionMode="Single" HeadersVisibility="None" GridLinesVisibility="None" IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" BorderThickness="0">
							<DataGrid.Styles>
								<Style Selector="DataGridCell">
									<Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
								</Style>
							</DataGrid.Styles>
							<Interaction.Behaviors>
								<behaviors:DataGridKeyboardBehavior FocusFirstRow="True"
																	MoveUpCommand="{Binding MoveStationUpCommand, DataType=vm:SortAtisStationsDialogViewModel}"
																	MoveDownCommand="{Binding MoveStationDownCommand, DataType=vm:SortAtisStationsDialogViewModel}"/>
								<behaviors:ScrollToSelectedItemBehavior/>
							</Interaction.Behaviors>
							<DataGrid.Columns>
								<DataGridTemplateColumn Width="*">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate DataType="models:AtisStation">
											<TextBlock Text="{Binding}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,2"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
							</DataGrid.Columns>
						</DataGrid>
					</Border>
					<!--Up/Down Buttons-->
					<StackPanel Grid.Column="2" Orientation="Vertical" Spacing="5">
						<Button Theme="{StaticResource Dark}" Command="{Binding MoveStationUpCommand, DataType=vm:SortAtisStationsDialogViewModel}">Move Up</Button>
						<Button Theme="{StaticResource Dark}" Command="{Binding MoveStationDownCommand, DataType=vm:SortAtisStationsDialogViewModel}">Move Down</Button>
					</StackPanel>
				</Grid>
			</StackPanel>
	</Border>
</Window>
