-        var helper = new OsxBuildTools(Log);
-        helper.CreateDittoZip(packDir, outputPath);
+        if (VelopackRuntimeInfo.IsOSX) {
+            var helper = new OsxBuildTools(Log);
+            helper.CreateDittoZip(packDir, outputPath);
+        } else {
+            if (File.Exists(outputPath)) File.Delete(outputPath);
+            var trimmed = packDir.TrimEnd('/');
+            Log.Debug(Exe.InvokeAndThrowIfNonZero("zip", new[] { "-qry", outputPath, Path.GetFileName(trimmed) }, Path.GetDirectoryName(trimmed)));
+        }
+
         progress(100);
         return Task.CompletedTask;
     }
