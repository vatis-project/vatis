+    private void RcodesignSign(Action<int> progress, string packDir)
+    {
+        var p12 = Environment.GetEnvironmentVariable("APPLE_CERT_P12");
+        if (String.IsNullOrEmpty(p12)) {
+            Log.Warn("Package will not be signed or notarized. Set APPLE_CERT_P12 (and APPLE_CERT_PASSWORD, APPLE_NOTARY_API_KEY) to sign with rcodesign.");
+            return;
+        }
+
+        var rcodesign = Environment.GetEnvironmentVariable("VPK_RCODESIGN");
+        if (String.IsNullOrEmpty(rcodesign)) rcodesign = "rcodesign";
+        var password = Environment.GetEnvironmentVariable("APPLE_CERT_PASSWORD") ?? "";
+        var notaryKey = Environment.GetEnvironmentVariable("APPLE_NOTARY_API_KEY");
+
+        var entitlements = Options.SignEntitlements;
+        if (String.IsNullOrEmpty(entitlements)) {
+            entitlements = HelperFile.VelopackEntitlements;
+        }
+
+        void Sign(string path, bool bundle)
+        {
+            var args = new List<string> { "sign", "--p12-file", p12, "--p12-password", password, "--code-signature-flags", "runtime" };
+            if (bundle) {
+                args.Add("--for-notarization");
+                args.Add("--entitlements-xml-path");
+                args.Add(entitlements);
+            }
+
+            args.Add(path);
+            Log.Info(Exe.InvokeAndThrowIfNonZero(rcodesign, args, null));
+        }
+
+        // Nested binaries first, so the bundle signature covers signed contents.
+        Log.Info("Code signing nested libraries and helpers with rcodesign...");
+        var macos = new OsxStructureBuilder(packDir).MacosDirectory;
+        foreach (var f in Directory.GetFiles(packDir, "*.dylib", SearchOption.AllDirectories)) Sign(f, false);
+        var updateMac = Path.Combine(macos, "UpdateMac");
+        if (File.Exists(updateMac)) Sign(updateMac, false);
+        progress(40);
+
+        Log.Info("Code signing application bundle with rcodesign...");
+        Sign(packDir, true);
+        progress(60);
+
+        if (String.IsNullOrEmpty(notaryKey)) {
+            Log.Warn("Package is signed but not notarized. Set APPLE_NOTARY_API_KEY to notarize.");
+            return;
+        }
+
+        var zipPath = Path.Combine(TempDir.FullName, "notarize.zip");
+        var parent = Path.GetDirectoryName(packDir.TrimEnd('/'));
+        Log.Info(Exe.InvokeAndThrowIfNonZero("zip", new[] { "-qry", zipPath, Path.GetFileName(packDir.TrimEnd('/')) }, parent));
+        Log.Info("Notarizing with rcodesign (this can take several minutes)...");
+        Log.Info(Exe.InvokeAndThrowIfNonZero(rcodesign, new[] { "notary-submit", "--api-key-file", notaryKey, "--wait", zipPath }, null));
+        progress(90);
+        Log.Info(Exe.InvokeAndThrowIfNonZero(rcodesign, new[] { "staple", packDir }, null));
+        File.Delete(zipPath);
+        progress(100);
+    }
+
